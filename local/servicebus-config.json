{
  "UserConfig": {
    "Namespaces": [
      {
        "Name": "sbemulatorns",
        "Properties": {
          "MessagingSku": "Standard"
        },
        "Queues": [
          {
            "Name": "archive-queue",
            "Properties": {
              "DeadLetteringOnMessageExpiration": true,
              "DefaultMessageTimeToLive": "PT1H",
              "RequiresDuplicateDetection": false,
              "RequiresSession": false,
              "EnablePartitioning": false
            }
          },
	  {
            "Name": "unarchive-queue",
            "Properties": {
              "DeadLetteringOnMessageExpiration": true,
              "DefaultMessageTimeToLive": "PT1H",
              "RequiresDuplicateDetection": false,
              "RequiresSession": false,
              "EnablePartitioning": false
            }
          }

        ]
      }
    ],
    "Logging": {
      "Type": "Console"
    }
  }
}
