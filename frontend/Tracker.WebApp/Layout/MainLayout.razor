@using Microsoft.AspNetCore.Components.Authorization
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users
@using Tracker.WebApp.States
@inherits LayoutComponentBase

<MudThemeProvider @bind-IsDarkMode=@_isDarkMode />
<MudLayout Style="height: 100vh; display: flex; flex-direction: column;">

    <MudAppBar Elevation="1" Fixed Class="d-flex">
        <MudIconButton Icon=@Icons.Material.Filled.Menu
                       Color="Color.Inherit"
                       Edge="Edge.Start"
                       OnClick=@DrawerToggle />
        <MudButton OnClick=@GoToHome
                   Color="Color.Inherit"
                   Style="background-color: inherit; box-shadow: none;">
            <MudText Typo=Typo.h6 Color="Color.Inherit">Tracker</MudText>
        </MudButton>

        <MudSpacer />

        @* ── Ongoing call strip ── *@
        @if (CallState.IsInCall)
        {
            <MudText>In call</MudText>
            <MudStack Row Spacing="1" AlignItems="AlignItems.Center" Class="mr-4">
                <MudIcon Icon=@Icons.Material.Filled.Circle Color="Color.Success" Size="Size.Small" />
                <MudText Typo="Typo.body2">@CallDuration</MudText>

                <MudIconButton Icon=@(CallState.IsMuted ? Icons.Material.Filled.MicOff : Icons.Material.Filled.Mic)
                               Color="@(CallState.IsMuted ? Color.Error : Color.Inherit)"
                               Size="Size.Small"
                               Title=@(CallState.IsMuted ? "Unmute" : "Mute")
                               OnClick=@CallState.ToggleMuteAsync />

                <MudIconButton Icon=@(CallState.IsVideoEnabled ? Icons.Material.Filled.Videocam : Icons.Material.Filled.VideocamOff)
                               Color="@(CallState.IsVideoEnabled ? Color.Inherit : Color.Error)"
                               Size="Size.Small"
                               Title=@(CallState.IsVideoEnabled ? "Turn off camera" : "Turn on camera")
                               OnClick=@CallState.ToggleVideoAsync />

                <MudIconButton Icon=@Icons.Material.Filled.CallEnd
                               Color="Color.Error"
                               Size="Size.Small"
                               Title="Leave call"
                               OnClick=@CallState.HangUpAsync />

                <MudIconButton Icon=@Icons.Material.Filled.OpenInFull
                               Color="Color.Inherit"
                               Size="Size.Small"
                               Title="Go to call"
                               OnClick=@GoToCall />

            </MudStack>
        }

        <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
            <MudToggleIconButton @bind-Toggled=@_isDarkMode
                                 Icon=@Icons.Material.Outlined.WbSunny
                                 ToggledIcon=@Icons.Material.Outlined.DarkMode
                                 Color="Color.Inherit" />
            <AuthorizeView>
                <NotAuthorized>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick=@GoToLogin>Login</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" OnClick=@GoToRegister>Register</MudButton>
                </NotAuthorized>
            </AuthorizeView>

            @if (AppState.IsAuthenticated)
            {
                <UserAvatarWithLookup User=@AppState.CurrentUser Size="Size.Medium">
                    <AdditionalActions>
                        <MudButton OnClick=@Logout IconColor="Color.Error">
                            <MudIcon Icon=@Icons.Material.Filled.Logout />
                            Logout
                        </MudButton>
                    </AdditionalActions>
                </UserAvatarWithLookup>
            }
        </MudStack>
    </MudAppBar>

    <MudDrawer @bind-Open="_isDrawerOpen"
               ClipMode="DrawerClipMode.Always"
               Elevation="2">
        <NavMenu />
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>
