@using Tracker.WebApp.States
@inject CallState CallState

@if (CallState.AudioDevices.Count > 0)
{
    <label class="device-panel__label">
        🎤 Microphone
        <select class="device-panel__select"
                value="@CallState.SelectedAudioDeviceId"
                @onchange="OnAudioChanged">
            @foreach (var d in CallState.AudioDevices)
            {
                <option value="@d.DeviceId">@d.Label</option>
            }
        </select>
    </label>
}

@if (CallState.VideoDevices.Count > 0)
{
    <label class="device-panel__label">
        📷 Camera
        <select class="device-panel__select"
                value="@CallState.SelectedVideoDeviceId"
                @onchange="OnVideoChanged">
            @foreach (var d in CallState.VideoDevices)
            {
                <option value="@d.DeviceId">@d.Label</option>
            }
        </select>
    </label>
}

@code {
    private async Task OnAudioChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { } id)
            await CallState.SwitchAudioDeviceAsync(id);
    }

    private async Task OnVideoChanged(ChangeEventArgs e)
    {
        if (e.Value?.ToString() is { } id)
            await CallState.SwitchVideoDeviceAsync(id);
    }
}
