@using Tracker.Domain.Dtos
@using Tracker.Services.Abstraction
@using Tracker.Services.Abstraction.Realtime
@using Tracker.WebApp.Components.Shared

<LoadingWrapper LoadingCondition=@(Call is null)
                IsLinear="false">
    <Content>
        <MudStack Row
                  Justify="Justify.Center"
                  AlignItems="AlignItems.Center">
                  <MudText Color="Color.Inherit">
                      Call in progress
                  </MudText>
            <DurationTimer @key=Call!.Id
                           StartTime=@Call!.StartedAt />

            <MudIconButton OnClick=@OpenCall
                           Icon=@Icons.Material.Filled.AddIcCall
                           Color="Color.Inherit" />

        </MudStack>
    </Content>
</LoadingWrapper>

