@using Tracker.Domain.Enums
<MudSelect Value=@Value
		   ValueChanged=@ValueChanged
		   Label="Choose workspace visibility"
		   Variant="Variant.Outlined">
	<MudSelectItem Value=@WorkspaceVisibility.Public>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Public /> Public
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@WorkspaceVisibility.Private>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Lock /> Private
		</MudStack>
	</MudSelectItem>
</MudSelect>