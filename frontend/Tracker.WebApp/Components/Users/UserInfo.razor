@using Microsoft.AspNetCore.Components.Authorization
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users

<MudGrid Class="pa-3">
    <MudItem xs="12" sm="4">
        <UserAvatar User=@User
                    Style="width:160px;height:160px;font-size:72px;" />
    </MudItem>

    <MudItem xs="12" sm="8">
        <MudStack>
            <MudStack Row
                      Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">@User.FirstName @User.LastName</MudText>

                <UserGlobalRoleChip Role="@User.Role" />
                @if (IsMe)
                {
                    <SubscriptionPlanChip Plan=AppState.Permissions.CurrentPlan />
                }
            </MudStack>

            <MudText Typo="Typo.h5">@User.Username</MudText>

            <MudText>@User.Email</MudText>

            @if (IsMe)
            {
                <MudStack Row
                          AlignItems="AlignItems.Center">
                    <MudButton Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick=@OpenSettingsAsync>
                        Change profile
                    </MudButton>
                    <MudStack Row>
                        <MudButton Color="Color.Primary"
                                   Variant="Variant.Filled"
                                   OnClick=@OpenSubscription>
                            See subscription plans
                        </MudButton>
                    </MudStack>
                </MudStack>
            }
            else
            {
                <AuthorizeView Policy="AdminOrHigher">
                    <MudButton FullWidth
                               Color="Color.Primary"
                               Variant="Variant.Filled"
                               OnClick=@OpenSettingsAsync>
                        Change
                    </MudButton>
                </AuthorizeView>
            }
        </MudStack>
    </MudItem>
</MudGrid>
