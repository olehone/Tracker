@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users

<MudStack>
	<MudStack Row Justify="Justify.SpaceBetween">
		<MudText Typo="Typo.h6">@User.FirstName @User.LastName</MudText>
		<MudText>@User.Role</MudText>
	</MudStack>
	<MudText Typo="Typo.h5">@User.Username</MudText>
	<MudText>@User.Email</MudText>
</MudStack>

