@using Tracker.Domain.Dtos

<MudTable T=@UserDto
		  ServerData=@LoadServerData
		  Dense
		  Hover
		  OnRowClick="@(args => OnRowClick.InvokeAsync(args.Item))"
		  @ref=@_table>

	<ToolBarContent>
		<MudTextField T="string"
					  ValueChanged=@(s => SetSearch(s))
					  TextUpdateSuppression="false"
					  Placeholder="Search username"
					  DebounceInterval="500"
					  Adornment="Adornment.Start"
					  AdornmentIcon="@Icons.Material.Filled.Search" />
	</ToolBarContent>

	<RowTemplate>
		@if (context is not null)
		{
			<MudTd>
				<UserAvatarSmall User=@context
								 Size="Size.Small" />
			</MudTd>

			<MudTd Class="text-ellipsis"
				   Style="max-width:10vw">
				@context.Username
			</MudTd>

			<MudTd>
				<MudIconButton Icon="@Icons.Material.Filled.Add"
							   Size="Size.Small"
							   Color="Color.Primary" />
			</MudTd>

			<MudTd>
				<a href=@($"/users/{context!.Id}")>
					<MudIcon Icon="@Icons.Material.Filled.OpenInNew"
							 Size="Size.Small"
							 Color="Color.Primary" />
				</a>
			</MudTd>
		}
	</RowTemplate>

	<NoRecordsContent>
		@if (string.IsNullOrEmpty(_search) || _search.Length < 3)
		{
			<MudText Typo="Typo.body2" Color="Color.Default">
				Type to search
			</MudText>
		}
		else
		{
			<MudText Typo="Typo.body2" Color="Color.Default">
				No users found
			</MudText>
		}
	</NoRecordsContent>
</MudTable>