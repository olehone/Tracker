@using Tracker.WebApp.Components.Shared

<MudAvatar Style=@ImageStyle
           Variant="Variant.Outlined"
           Size=@Size
           @onmouseenter=@(() => HandleHovering.InvokeAsync(true))
           @onmouseleave=@(() => HandleHovering.InvokeAsync(false))>
    @if (!string.IsNullOrWhiteSpace(_avatarUrl))
    {
        <CustomImage Src=@_avatarUrl
                     ObjectFit="ObjectFit.Cover"
                     HandleError=@HandleImageError />
        <MudLink Href=@_avatarUrl />
    }
    else
    {
        @FirstLetter()
    }
</MudAvatar>