@if (User.AvatarUrl is null)
{
	<MudAvatar Style=@CustomColor
			   Variant="Variant.Outlined"
			   Size=@Size
			   @onmouseenter=@(() => HandleHovering.InvokeAsync(true))
			   @onmouseleave=@(() => HandleHovering.InvokeAsync(false))>
		@FirstLetter()
	</MudAvatar>
}
else
{
	<MudAvatar Color=@Color
			   Variant="Variant.Outlined">
		<MudImage Src=@User.AvatarUrl></MudImage>
	</MudAvatar>
}