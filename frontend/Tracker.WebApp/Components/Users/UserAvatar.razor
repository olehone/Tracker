@using Tracker.WebApp.Components.Shared
<MudAvatar Style=@CustomColor
           Variant="Variant.Outlined"
           Size=@Size
           @onmouseenter=@(() => HandleHovering.InvokeAsync(true))
           @onmouseleave=@(() => HandleHovering.InvokeAsync(false))>
    @if (!string.IsNullOrEmpty(User.AvatarUrl) && !_avatarFailed)
    {
        <CustomImage Src=@User.AvatarUrl ObjectFit="ObjectFit.Cover" @onerror=@(() => HandleImageError())/>
    }
    else
    {
        @FirstLetter()
    }
</MudAvatar>