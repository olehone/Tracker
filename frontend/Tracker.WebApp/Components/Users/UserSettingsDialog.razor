@using Tracker.Domain.Requests.Users

<MudStack AlignItems="AlignItems.Center"
          Justify="Justify.Center"
          Class="pa-2">
    <UserAvatar User="@User"
                Style="width:200px;height:200px;font-size:90px" />

    <MudStack Row
              Justify="Justify.SpaceAround">
        <MudFileUpload T="IBrowserFile"
                       Accept=".png,.jpg,.jpeg"
                       FilesChanged=@UploadAvatarAsync
                       MaximumFileCount="1">
            <ActivatorContent>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon=@Icons.Material.Filled.CloudUpload>
                    Update avatar
                </MudButton>
            </ActivatorContent>
        </MudFileUpload>

        @if (User.AvatarUrl is not null)
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon=@Icons.Material.Filled.CloudUpload
                       OnClick=@DeleteAvatarAsync>
                Delete avatar
            </MudButton>
        }
    </MudStack>

    <MudForm @ref=@_form
             @bind-IsValid=@_isValid
             Model=@_model
             Validation=@_validator
             Class="mud-width-full">
        <MudStack Spacing="3">
            <MudTextField T="string"
                          @bind-Value=@_model.FirstName
                          Label="First Name"
                          For=@(() => _model.FirstName)
                          Variant="Variant.Outlined"
                          Required
                          Immediate />

            <MudTextField T="string"
                          @bind-Value=@_model.LastName
                          Label="Last Name"
                          Variant="Variant.Outlined"
                          For=@(() => _model.LastName) />

            <MudTextField T="string"
                          @bind-Value=@_model.Username
                          Label="Username"
                          For=@(() => _model.Username)
                          Variant="Variant.Outlined"
                          Required
                          Immediate />

            @if (_errorMessages is not null && _errorMessages.Count > 0)
            {
                @foreach (var error in _errorMessages)
                {
                    <MudAlert Severity="Severity.Error" Dense>
                        @error
                    </MudAlert>
                }
            }

            <MudStack Row Spacing="2">
                <MudButton OnClick=@HandleSubmitAsync
                           Disabled=@(_isLoading || !_isValid)
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth>
                    @if (_isLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Class="mx-3" />
                        <MudText>Saving...</MudText>
                    }
                    else
                    {
                        <MudText>Save</MudText>
                    }
                </MudButton>

                <MudButton OnClick=@Cancel
                           Disabled=@_isLoading
                           Variant="Variant.Outlined"
                           Color="Color.Default">
                    Cancel
                </MudButton>
            </MudStack>
        </MudStack>
    </MudForm>
</MudStack>