@using Tracker.Domain.Dtos

<MudTable T=@UserDto
		  ServerData=@LoadServerData
		  FixedHeader
		  Height="70vh"
		  Dense
		  Hover
		  @ref=@_table>

	<ToolBarContent>
		<MudText Typo="Typo.h6">Users</MudText>
		<MudSpacer />
		<MudTextField T="string"
					  ValueChanged=@(s => SetSearch(s))
					  TextUpdateSuppression="false"
					  Placeholder="Search username"
					  DebounceInterval="500"
					  Adornment="Adornment.Start"
					  AdornmentIcon="@Icons.Material.Filled.Search" />
	</ToolBarContent>

	<HeaderContent>
		<MudTh>Avatar</MudTh>
		<MudTh>Username</MudTh>
		<MudTh>Email</MudTh>
		<MudTh>Name</MudTh>
		<MudTh>Role</MudTh>
		<MudTh>Profile</MudTh>
	</HeaderContent>

	<RowTemplate>
		@if (context is not null)
		{
			<MudTd>
				<UserAvatarWithLookup User=@context
									  Size="Size.Medium" />
			</MudTd>

			<MudTd Class="text-ellipsis"
				   Style="max-width:20vw">
				@context.Username
			</MudTd>

			<MudTd Class="text-ellipsis"
				   Style="max-width:20vw">
				@context.Email
			</MudTd>

			<MudTd Class="text-ellipsis"
				   Style="max-width:20vw">
				@context.FirstName @context.LastName
			</MudTd>

			<MudTd>
				<UserGlobalRoleChip Role=@context.Role />
			</MudTd>

			<MudTd>
				<a href=@($"/users/{context!.Id}")>
					<MudIcon Icon="@Icons.Material.Filled.OpenInNew"
							 Size="Size.Small"
							 Color="Color.Primary" />
				</a>
			</MudTd>
		}
	</RowTemplate>
	<PagerContent>
		<MudTablePager />
	</PagerContent>
</MudTable>