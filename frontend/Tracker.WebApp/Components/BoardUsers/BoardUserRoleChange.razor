@using Tracker.Domain.Enums
@using Tracker.WebApp.Components.BoardUsers

@inherits BoardUsersSubscribeBase

<MudSelect T=@BoardUserRole
		   Value=@_currentRole
		   ValueChanged=@(v => _currentRole = v)
		   Dense
		   Style="min-width: 160px; width: 160px;"
		   Margin=@Margin.None
		   Variant=@Variant.Text>

	<MudSelectItem Value=@BoardUserRole.Observer>
		<MudStack Row>
			<MudIcon Icon=@BoardRoleHelper.GetRoleIcon(BoardUserRole.Observer) />
			Observer
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@BoardUserRole.Member>
		<MudStack Row>
			<MudIcon Icon=@BoardRoleHelper.GetRoleIcon(BoardUserRole.Member) />
			Member
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@BoardUserRole.Admin>
		<MudStack Row>
			<MudIcon Icon=@BoardRoleHelper.GetRoleIcon(BoardUserRole.Admin) />
			Admin
		</MudStack>
	</MudSelectItem>

</MudSelect>

@if (HasChanged)
{
	<MudIconButton Icon=@Icons.Material.Filled.Check
				   Variant=@Variant.Outlined
				   Color=@Color.Success
				   Size=@Size.Medium
				   OnClick=@SubmitAsync />
}