@using Tracker.Domain.Dtos
@using Tracker.Domain.Enums
@inherits BoardUsersSubscribeBase

@if (Users.CanChangeMembers())
{ 
	<MudPaper Elevation="0"
			  Class="pa-4">
		<MudGrid Class="align-end">
			<MudItem xs="12"
					 md="8">
				<MudAutocomplete T=@UserDto
								 @bind-Value=@_selectedUser
								 ResetValueOnEmptyText
								 SelectValueOnTab
								 Label="Search users to add"
								 SearchFunc=@Users.SearchAsync
								 Dense
								 ItemDisabledFunc=@Users.IsUserMember
								 AdornmentIcon=@Icons.Material.Filled.Search
								 ToStringFunc=@(u => u == null ? null : $"{u.Username}")>
					<ItemDisabledTemplate>
						<MudText>@context.Username</MudText>
					</ItemDisabledTemplate>
				</MudAutocomplete>
			</MudItem>

			<MudItem xs="12"
					 md="4">
				<BoardUserRoleSelect @bind-Role=_selectedRole />
			</MudItem>

			<MudItem xs="12"
					 md="12">
				<MudButton Color=@Color.Primary
						   Variant=@Variant.Outlined
						   OnClick=@AddUser
						   Disabled=@(_selectedUser is null)
						   FullWidth>

					<MudText>Add user to board</MudText>

					<MudDivider Vertical />

					<MudIcon Icon=@Icons.Material.Filled.PersonAdd />

				</MudButton>
			</MudItem>
		</MudGrid>
	</MudPaper>
}