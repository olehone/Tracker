@using Tracker.Domain.Enums

<MudSelect Value=@Role
		   ValueChanged=@RoleChanged
		   Dense
		   Variant=@Variant.Text>

	<MudSelectItem Value=@BoardUserRole.Observer>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Visibility />
			Observer
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@BoardUserRole.Member>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Person />
			Member
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@BoardUserRole.Admin>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Person />
			Admin
		</MudStack>
	</MudSelectItem>

</MudSelect>
