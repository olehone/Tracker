@using Tracker.Services.Abstraction
@using Tracker.WebApp.Components.Subscription

<SubscriptionWrapper IsAllowed=@AppState.Permissions.CanUseAi>
    <Content>
        <div class="pa-6 mud-height-full mud-width-full">
            <MudText Typo="Typo.h5"
                     Class="mb-4">
                FAQ Assistant
            </MudText>

            <MudPaper Outlined
                      Class="pa-3 mb-4"
                      Style="overflow-y:auto; height:80%">
                @foreach (var msg in _messages)
                {
                    <MudChat ChatPosition="@(msg.IsUser? ChatBubblePosition.End: ChatBubblePosition.Start)">
                        <MudChatBubble>@msg.Text</MudChatBubble>
                    </MudChat>
                }
                @if (_isLoading)
                {
                    <MudChat ChatPosition="ChatBubblePosition.Start">
                        <MudChatBubble>
                            <MudProgressCircular Size="Size.Small"
                                                 Indeterminate />
                        </MudChatBubble>
                    </MudChat>
                }
                <div @ref=@_scrollAnchor style="height:1px"></div>
            </MudPaper>

            <MudStack Row="true" Spacing="2">
                <MudTextField @bind-Value=@_input
                              Placeholder="Ask a question..."
                              Variant="Variant.Outlined"
                              FullWidth
                              Immediate
                              Disabled=@_isLoading
                              OnKeyDown=@HandleKeyDown />
                <MudIconButton Icon=@Icons.Material.Filled.Send
                               Color="Color.Primary"
                               Size="Size.Large"
                               Variant="Variant.Filled"
                               Disabled=@_isLoading
                               OnClick=@SendMessage />
            </MudStack>
        </div>
    </Content>
</SubscriptionWrapper>