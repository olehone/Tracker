@using Microsoft.AspNetCore.Components.Authorization
@using Tracker.Domain.Dtos
@using Tracker.Domain.Enums
@using Tracker.WebApp.Shared

<AuthorizeView Policy="AdminOrHigher">
	<Authorized>
		<MudDivider Class="my-2" />
		<MudText Typo="Typo.caption"
				 Align="Align.Center"
				 Class="ps-4">
			Admin panel
		</MudText>

		<MudNavGroup Icon=@Icons.Material.Filled.Settings
					 Title="Settings"
					 Expanded="true">
			<MudNavLink Icon=@Icons.Material.Filled.Person
						Href="/admin/users">
				Users
			</MudNavLink>

			<MudNavLink Icon=@Icons.Material.Filled.Dashboard
						Href="/admin/workspaces">
				Workspaces
			</MudNavLink>
		</MudNavGroup>
	</Authorized>
</AuthorizeView>