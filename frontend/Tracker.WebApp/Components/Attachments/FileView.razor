@using Tracker.WebApp.Shared

<div class="pa-2 mud-width-full">
    <MudTooltip>
        <ChildContent>
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween"
                      Class=@GetClass()
                      Style="@($"background:{Colors.Gray.Lighten3};")">

                <MudText Class="mx-2"
                         Style=@(File.IsDeleted ? "text-decoration: line-through;" : "")>
                    @File.FileName
                </MudText>
                <MudStack Row
                          AlignItems="AlignItems.Center"
                          Justify="Justify.SpaceBetween">
                    <MudText Class="text-ellipsis">
                        @UiHelper.FileSize(File.SizeBytes)
                    </MudText>
                    @if (!Disabled && !File.IsDeleted)
                    {
                        <MudIconButton Icon=@Icons.Material.Filled.ArrowDownward
                                       OnClick=@Download />
                        <MudIconButton Icon=@Icons.Material.Filled.Delete
                                       OnClick=@Delete />
                    }
                </MudStack>
            </MudStack>
        </ChildContent>
        <TooltipContent>
            <MudStack Row
                      AlignItems="AlignItems.Center"
                      Justify="Justify.SpaceBetween">
                <MudText>
                    Uploaded at: @File.UploadedAt.ToLocalTime().DateTime
                </MudText>
                <MudText>
                    By: @File.UploadedByName
                </MudText>
            </MudStack>
        </TooltipContent>
    </MudTooltip>
</div>