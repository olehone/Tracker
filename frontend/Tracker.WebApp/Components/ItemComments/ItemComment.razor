@using Tracker.Domain.Dtos
@using Tracker.Domain.Enums
@using Tracker.Domain.Requests
@using Tracker.Domain.Requests.ItemComment
@using Tracker.Services
@using Tracker.Services.Abstraction
@using Tracker.WebApp.Components.Attachments
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users
@using Tracker.WebApp.States

@if (_isEditing)
{
    <div>
        <FormWithAttachments @bind-Model=@model
                             OnSubmit=@UpdateCommentAsync
                             OnClear=@CancelEdit
                             ExistingAttachmentsCount=@(() => Comment.Attachments.Count(a=> !a.IsDeleted)) />
        @foreach (var attachment in Comment.Attachments)
        {
            <FileView File=@attachment
                      Disabled="false" />
        }
    </div>
}
else
{
    <MudChatBubble>
        @Comment.Content
        @foreach (var attachment in Comment.Attachments)
        {
            <FileView File=@attachment
                      Disabled="true" />
        }

        <MudChatFooter>
            <MudStack Justify="Justify.SpaceBetween"
                      Row>
                @Comment.UploadedAt.ToLocalTime().ToString("T")
                @if (Comment.UpdatedAt.HasValue)
                {
                    <MudTooltip Text=@($"Edited at {Comment.UpdatedAt.Value.ToLocalTime().ToString("F")}")>
                        <MudIcon Icon=@Icons.Material.Filled.Edit
                                 Size="Size.Small"
                                 Color="Color.Default" />
                    </MudTooltip>
                }
                <MudSpacer />
                @if (CanChange())
                {
                    <MudMenu Icon=@Icons.Material.Filled.MoreVert
                             Size="Size.Small">
                        <MudMenuItem Label="Edit"
                                     OnClick=@StartEditing />
                        <MudMenuItem Label="Delete"
                                     OnClick=@DeleteCommentAsync />
                    </MudMenu>
                }

            </MudStack>
        </MudChatFooter>
    </MudChatBubble>
}