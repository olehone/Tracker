@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Attachments
@using Tracker.WebApp.Components.Users

<MudStack Row
          AlignItems="AlignItems.Start"
          Class="ma-2 mud-full-width">
    <UserAvatarWithLookup User=@Comment.UploadedBy />

    <div class="border-solid">
        <MudText>@Comment.Content</MudText>
        @foreach (var attachment in Comment.Attachments)
        {
            <FileView File=@attachment
                      Disabled="true" />
        }
    </div>
</MudStack>

@code {
    [Parameter, EditorRequired]
    public ItemCommentDto Comment { get; set; }
    [Parameter, EditorRequired]
    public bool Disabled { get; set; }
}