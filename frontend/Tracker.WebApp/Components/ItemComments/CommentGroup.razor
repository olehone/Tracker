@using Tracker.Domain.Dtos
@using Tracker.Domain.Requests.ItemComment
@using Tracker.Services
@using Tracker.Services.Abstraction
@using Tracker.WebApp.Components.Attachments
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users




<MudChat ChatPosition=@_position>
    <UserAvatarWithLookup User=@_user />

    <MudChatHeader Name=@(_isMine ? null : _user.Username)
                   Time=@Group.First().UploadedAt.ToLocalTime().DateTime.ToString("D") />
    @foreach (var comment in Group)
    {
        <ItemComment Comment=@comment
                     MaxAttachmentSizeBytes=@MaxAttachmentSizeBytes
                     OnDelete=@(() => ApplyCommentDeleted.InvokeAsync(comment.Id)) />
    }
</MudChat>

@code {
    private UserDto _user;
    private bool _isMine;
    private ChatBubblePosition _position;

    [Parameter, EditorRequired]
    public List<ItemCommentDto> Group { get; set; }
    [Parameter, EditorRequired]
    public int MaxAttachmentSizeBytes { get; set; }
    [Parameter, EditorRequired]
    public EventCallback<Guid> ApplyCommentDeleted { get; set; }
    [Parameter, EditorRequired]
    public Func<Guid, bool> IsMine { get; set; }

    protected override void OnParametersSet()
    {
        _user = Group.First().UploadedBy;
        _isMine = IsMine(_user.Id);
        _position = _isMine
            ? ChatBubblePosition.End
            : ChatBubblePosition.Start;
    }
}