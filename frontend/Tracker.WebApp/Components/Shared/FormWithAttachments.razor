@using FluentValidation
@using Severity = MudBlazor.Severity
@inject ISnackbar Snackbar

<MudCard>
    <MudForm Model="@Model" @ref="@form" Validation="@(ValidationRules.ValidateValue)" ValidationDelay="0">
        <MudCardContent>
            <MudStack>
                <MudTextField @bind-Value="Model.Text"
                              For="@(() => Model.Text)"
                              Lines="3"
                              Counter=@MaxTextLength
                              MaxLength=@MaxTextLength />

                <MudGrid Justify="@Justify.FlexEnd" Spacing="1">
                    <MudItem>
                        <MudFileUpload @ref="@_fileUpload"
                                       T="IReadOnlyList<IBrowserFile>"
                                       For=@(() => Model.Attachments)
                                       @bind-Files="Model.Attachments"
                                       OnFilesChanged="HandleFilesChanged"
                                       Accept="@AcceptedExtensions"
                                       AppendMultipleFiles
                                       SuppressOnChangeWhenInvalid="true">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    Upload Files
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </MudItem>
                    <MudItem>
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="@ClearAsync">
                            Clear Files
                        </MudButton>
                    </MudItem>
                </MudGrid>

                @if (Model.Attachments?.Any() == true)
                {
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudText Typo="Typo.subtitle2" Class="mb-2">Selected Files (@Model.Attachments.Count)</MudText>
                        @foreach (var file in Model.Attachments)
                        {
                            <MudText>
                                <strong>@file.Name</strong> - @FormatFileSize(file.Size)
                            </MudText>
                        }
                    </MudPaper>
                }
            </MudStack>
        </MudCardContent>
        <MudCardActions>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Class="ml-auto"
                       OnClick="@Submit"
                       Disabled="@IsSubmitting">
                @if (IsSubmitting)
                {
                    <MudProgressCircular Class="mr-2" Size="Size.Small" Indeterminate="true" />
                }
                Submit
            </MudButton>
        </MudCardActions>
    </MudForm>
</MudCard>

@code {
    [Parameter]
    public int MaxTextLength { get; set; } = 500;
    [Parameter]
    public long MaxFileSizeBytes { get; set; } = 104857600;
    [Parameter]
    public int MaxFileCount { get; set; } = 5;
    [Parameter]
    public string AcceptedExtensions { get; set; } = "*";
    [Parameter, EditorRequired]
    public EventCallback<TextWithAttachmentsModel> OnSubmit { get; set; }
    [Parameter, EditorRequired]
    public TextWithAttachmentsModel Model { get; set; } = new();
    [Parameter, EditorRequired]
    public EventCallback<TextWithAttachmentsModel> ModelChanged { get; set; }

    private MudForm form;
    private TextWithAttachmentsModelValidator ValidationRules;
    private MudFileUpload<IReadOnlyList<IBrowserFile>> _fileUpload;
    private bool IsSubmitting;

    protected override void OnInitialized()
    {
        ValidationRules = new TextWithAttachmentsModelValidator(MaxTextLength, MaxFileSizeBytes, MaxFileCount);
    }

    protected override void OnParametersSet()
    {
        // Reinitialize validator if parameters change
        ValidationRules = new TextWithAttachmentsModelValidator(MaxTextLength, MaxFileSizeBytes, MaxFileCount);
    }

    private async Task HandleFilesChanged(InputFileChangeEventArgs e)
    {
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;

        if (Model.Attachments?.Any() == true)
        {
            Snackbar.Add($"Selected {Model.Attachments.Count} file(s)", Severity.Info);
        }

        await ModelChanged.InvokeAsync(Model);
    }

    private async Task Submit()
    {
        await form.Validate();

        if (form.IsValid)
        {
            IsSubmitting = true;
            StateHasChanged();

            await OnSubmit.InvokeAsync(Model);
            IsSubmitting = false;
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Please fix validation errors", Severity.Warning);
        }
    }

    private Task ClearAsync()
        => _fileUpload?.ClearAsync() ?? Task.CompletedTask;

    private string FormatFileSize(long bytes)
    {
        string[] sizes = { "B", "KB", "MB", "GB" };
        double len = bytes;
        int order = 0;
        while (len >= 1024 && order < sizes.Length - 1)
        {
            order++;
            len = len / 1024;
        }
        return $"{len:0.##} {sizes[order]}";
    }

    public class TextWithAttachmentsModelValidator : AbstractValidator<TextWithAttachmentsModel>
    {
        public TextWithAttachmentsModelValidator(int maxTextLength, long maxFileSizeBytes, int maxFileCount)
        {
            RuleFor(x => x.Text)
                .NotEmpty()
                .WithMessage("Text is required")
                .MaximumLength(maxTextLength)
                .WithMessage($"Text cannot exceed {maxTextLength} characters");

            RuleFor(x => x.Attachments)
                .Must(files => files == null || files.Count <= maxFileCount)
                .WithMessage($"Maximum {maxFileCount} files allowed");

            When(x => x.Attachments != null && x.Attachments.Any(), () =>
            {
                RuleFor(x => x.Attachments)
                    .Must(files => files.All(f => f.Size <= maxFileSizeBytes))
                    .WithMessage($"Each file must be less than {FormatBytes(maxFileSizeBytes)}");
            });
        }

        private static string FormatBytes(long bytes)
        {
            string[] sizes = { "B", "KB", "MB", "GB" };
            double len = bytes;
            int order = 0;
            while (len >= 1024 && order < sizes.Length - 1)
            {
                order++;
                len = len / 1024;
            }
            return $"{len:0.##} {sizes[order]}";
        }

        public Func<object, string, Task<IEnumerable<string>>> ValidateValue => async (model, propertyName) =>
        {
            var result = await ValidateAsync(ValidationContext<TextWithAttachmentsModel>
                .CreateWithOptions((TextWithAttachmentsModel)model, x => x.IncludeProperties(propertyName)));

            if (result.IsValid)
                return Array.Empty<string>();

            return result.Errors.Select(e => e.ErrorMessage);
        };
    }
}