@using Markdig
@using Markdig.Syntax
@using Markdig.Syntax.Inlines
@using Microsoft.AspNetCore.Components.Rendering
@using PSC.Blazor.Components.MarkdownEditor.Enums
@using PSC.Blazor.Components.MarkdownEditor.Models
@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Attachments

@if (_isPreview)
{
    <MudPaper Outlined MaxHeight="400px" Class="pa-2">
        <MudStack Row
                  AlignItems="AlignItems.Center"
                  Justify="Justify.SpaceBetween">
            @if (Header is not null)
            {
                <MudListSubheader Gutters="false">
                    @Header
                </MudListSubheader>
            }

            <MudIconButton Color="Color.Primary"
                           Icon=@Icons.Material.Filled.RemoveRedEye
                           Disabled=@Disabled
                           OnClick=@TogglePreview />
        </MudStack>
        @RenderMarkdownWithAttachments(Value)
    </MudPaper>
}
else
{
    <MarkdownEditor @bind-Value=@Value
                    AllowResize="false"
                    AutoSaveEnabled="true"
                    Theme=@($"mud-theme-{Color.Surface.ToDescriptionString()}")
                    CustomButtonClicked=@OnCustomButtonClicked>
        @* HideIcons and ShowIcons don't work, have to rewrite default icons manually *@
        <Toolbar>
            <MarkdownToolbarButton Action="MarkdownAction.Bold"
                                   Icon="fa fa-bold"
                                   Title="Bold" />

            <MarkdownToolbarButton Action="MarkdownAction.Italic"
                                   Icon="fa fa-italic"
                                   Title="Italic" />

            <MarkdownToolbarButton Action="MarkdownAction.Heading"
                                   Icon="fa fa-header"
                                   Title="Heading" />

            <MarkdownToolbarButton Action="MarkdownAction.Code"
                                   Icon="fa fa-code"
                                   Title="Code Block"
                                   Separator />

            <MarkdownToolbarButton Action="MarkdownAction.Quote"
                                   Icon="fa fa-quote-left"
                                   Title="Quote" />

            <MarkdownToolbarButton Action="MarkdownAction.UnorderedList"
                                   Icon="fa fa-list-ul"
                                   Title="Unordered List" />

            <MarkdownToolbarButton Action="MarkdownAction.OrderedList"
                                   Icon="fa fa-list-ol"
                                   Title="Ordered List" />

            <MarkdownToolbarButton Action="MarkdownAction.Link"
                                   Icon="fa fa-link"
                                   Title="Insert Link"
                                   Separator />

            <MarkdownToolbarButton Action="MarkdownAction.Image"
                                   Icon="fa fa-picture-o"
                                   Title="Insert Image" />

            <MarkdownToolbarButton Action="MarkdownAction.Table"
                                   Icon="fa fa-table"
                                   Title="Insert Table" />



            <MarkdownToolbarButton Action="MarkdownAction.Fullscreen"
                                   Name="mde-tb-fullscreen"
                                   Icon="fa fa-arrows-alt no-disable no-mobile"
                                   Title="Fullscreen"
                                   Separator />

            <MarkdownToolbarButton Icon="fa fa-eye no-disable"
                                   Name=@_togglePreviewName
                                   Title="Preview" />

        </Toolbar>
    </MarkdownEditor>

    <MudFileUpload T="IBrowserFile"
                   Disabled=@Disabled
                   FilesChanged=@UploadAndAddAsync
                   MaximumFileCount="1">
        <ActivatorContent>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon=@Icons.Material.Filled.AttachFile>
                Attach
            </MudButton>
        </ActivatorContent>
    </MudFileUpload>
}


@code {
    private const string _togglePreviewName = "toggle-preview";

    private bool _isPreview = true;

    [Parameter, EditorRequired]
    public string Value { get; set; }
    [Parameter, EditorRequired]
    public EventCallback<string> ValueChanged { get; set; }

    [Parameter]
    public string Header { get; set; }
    [Parameter, EditorRequired]
    public List<FileDto> Attachments { get; set; }
    [Parameter, EditorRequired]
    public EventCallback<IBrowserFile?> UploadAsync { get; set; }
    [Parameter, EditorRequired]
    public bool Disabled { get; set; }

    private RenderFragment RenderMarkdownWithAttachments(string markdown) => builder =>
    {
        if (string.IsNullOrEmpty(markdown)) return;

        var html = Markdown.ToHtml(markdown);
        var document = Markdown.Parse(markdown);
        var attachmentLinks = document.Descendants<LinkInline>()
            .Where(link => link.Url?.StartsWith("api/attachments/") == true)
            .ToList();

        if (!attachmentLinks.Any())
        {
            builder.AddMarkupContent(0, html);
            return;
        }

        int seq = 0;
        var remainingHtml = html;

        foreach (var link in attachmentLinks)
        {
            var id = link.Url.Split('/').Last();
            if (!Guid.TryParse(id, out var idGuid)) continue;

            var file = Attachments?.FirstOrDefault(a => a.Id == idGuid);
            if (file == null) continue;

            // Find the HTML representation of this link
            var linkHtml = $"<a href=\"api/attachments/{idGuid}\">";
            var linkEndHtml = "</a>";

            var linkStart = remainingHtml.IndexOf(linkHtml);
            if (linkStart == -1) continue;

            var linkEnd = remainingHtml.IndexOf(linkEndHtml, linkStart);
            if (linkEnd == -1) continue;

            // Add HTML before the link
            var beforeLink = remainingHtml.Substring(0, linkStart);
            if (!string.IsNullOrEmpty(beforeLink))
            {
                builder.AddMarkupContent(seq++, beforeLink);
            }

            // Add FileView component instead of link
            builder.OpenComponent<FileView>(seq++);
            builder.AddAttribute(seq++, "File", file);
            builder.AddAttribute(seq++, "Disabled", Disabled);
            builder.CloseComponent();

            // Continue with remaining HTML
            remainingHtml = remainingHtml.Substring(linkEnd + linkEndHtml.Length);
        }

        // Add any remaining HTML
        if (!string.IsNullOrEmpty(remainingHtml))
        {
            builder.AddMarkupContent(seq++, remainingHtml);
        }
    };

    private async Task UploadAndAddAsync(IBrowserFile file)
    {
        await UploadAsync.InvokeAsync(file);

    }

    private Task OnCustomButtonClicked(MarkdownButtonEventArgs eventArgs)
    {
        if (eventArgs.Name == _togglePreviewName)
        {
            TogglePreview();
        }
        return Task.CompletedTask;
    }

    private void TogglePreview()
    {
        _isPreview = !_isPreview;
    }
}