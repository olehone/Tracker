@using Markdig
@using Markdig.Syntax
@using Markdig.Syntax.Inlines
@using PSC.Blazor.Components.MarkdownEditor.Enums
@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Attachments

<MarkdownEditor Value="@Value"
                ValueChanged="@OnMarkdownValueChanged"
                ValueHTMLChanged="@OnMarkdownValueHTMLChanged"
                ValueHTML=@markdownHtml>
    @* HideIcons and ShowIcons don't work, have to rewrite default icons manually *@
    <Toolbar>
        <MarkdownToolbarButton Action="MarkdownAction.Bold"
                               Icon="fa fa-bold"
                               Title="Bold" />

        <MarkdownToolbarButton Action="MarkdownAction.Italic"
                               Icon="fa fa-italic"
                               Title="Italic" />

        <MarkdownToolbarButton Action="MarkdownAction.Heading"
                               Icon="fa fa-header"
                               Title="Heading" />

        <MarkdownToolbarButton Action="MarkdownAction.Code"
                               Icon="fa fa-code"
                               Title="Code Block"
                               Separator />

        <MarkdownToolbarButton Action="MarkdownAction.Quote"
                               Icon="fa fa-quote-left"
                               Title="Quote" />

        <MarkdownToolbarButton Action="MarkdownAction.UnorderedList"
                               Icon="fa fa-list-ul"
                               Title="Unordered List" />

        <MarkdownToolbarButton Action="MarkdownAction.OrderedList"
                               Icon="fa fa-list-ol"
                               Title="Ordered List" />

        <MarkdownToolbarButton Action="MarkdownAction.Link"
                               Icon="fa fa-link"
                               Title="Insert Link"
                               Separator />

        <MarkdownToolbarButton Action="MarkdownAction.Image"
                               Icon="fa fa-picture-o"
                               Title="Insert Image" />

        <MarkdownToolbarButton Action="MarkdownAction.Table"
                               Icon="fa fa-table"
                               Title="Insert Table" />


        @* <MarkdownToolbarButton Action="MarkdownAction.Preview"
                                   Icon="fa fa-eye no-disable"
                                   Title="Preview" /> *@

        <MarkdownToolbarButton Action="MarkdownAction.Fullscreen"
                               Name="mde-tb-fullscreen"
                               Icon="fa fa-arrows-alt no-disable no-mobile"
                               Title="Fullscreen"
                               Separator />


    </Toolbar>
</MarkdownEditor>
<MudText Typo="Typo.h1"> MarkupString </MudText>
@((MarkupString)markdownHtml)
<MudText Typo="Typo.h1"> Purehtml </MudText>
@(markdownHtml)
<MudText Typo="Typo.h1"> RenderMarkdonw </MudText>
@RenderMarkdown(Value)


@code {
    [Parameter, EditorRequired]
    public EventCallback<IBrowserFile?> UploadAsync { get; set; }
    [Parameter, EditorRequired]
    public List<FileDto> Attachments { get; set; }
    [Parameter, EditorRequired]
    public bool Disabled { get; set; }

    [Parameter, EditorRequired]
    public EventCallback<string> ValueChanged { get; set; }
    [Parameter, EditorRequired]
    [Category(CategoryTypes.FormComponent.Data)]
    public string Value
    {
        get => markdownValue;
        set => markdownValue = value ?? string.Empty;
    }

    string markdownValue = "# Markdown Editor\nThis is a test";
    string markdownHtml;
    const string attachment = "[attachment](api/attachments/83109ff0-d5d1-49e5-b36d-deacfc47ba75)";
    protected override void OnInitialized()
    {
        markdownHtml = Markdig.Markdown.ToHtml(markdownValue ?? string.Empty);
        markdownHtml += "<a> It is custom html here! </a>";
        base.OnInitialized();
    }

    Task OnMarkdownValueChanged(string value)
    {
        return Task.CompletedTask;
    }

    Task OnMarkdownValueHTMLChanged(string value)
    {
        markdownHtml = value;
        markdownHtml += "<a> It is custom html here! </a>";
        markdownHtml = markdownHtml.Replace("is", "was");
        return Task.CompletedTask;
    }

    private RenderFragment RenderMarkdown(string markdown) => builder =>
{
    var pipeline = new MarkdownPipelineBuilder().Build();
    var document = Markdown.Parse(markdown ?? string.Empty, pipeline);

    int seq = 0;

    foreach (var block in document)
    {
        if (block is ParagraphBlock paragraph)
        {
            builder.OpenElement(seq++, "p");

            var inline = paragraph.Inline?.FirstChild;

            while (inline != null)
            {
                if (inline is LinkInline link &&
                    link.Url != null &&
                    link.Url.StartsWith("api/attachments/"))
                {
                    var id = link.Url.Split('/').Last();
                    if (!Guid.TryParse(id, out Guid idGuid))
                    {
                        return;
                    }
                    var file = Attachments.FirstOrDefault(a => a.Id == idGuid);
                    if (file is null)
                    {
                        return;
                    }
                    builder.OpenComponent<FileView>(seq++);
                    builder.AddAttribute(seq++, "File", file);
                    builder.AddAttribute(seq++, "Disabled", Disabled);
                    builder.CloseComponent();
                }
                else
                {
                    builder.AddContent(seq++, inline.ToString());
                }

                inline = inline.NextSibling;
            }

            builder.CloseElement();
        }
    }
};

}