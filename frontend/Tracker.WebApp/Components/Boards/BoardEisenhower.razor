@using Tracker.WebApp.Components.BoardItems
@using MudBlazor

<MudGrid Spacing="2" Style="height:100%; min-height: 600px;">
    <MudItem xs="12" md="6">
        <BoardItemsQuadrant Items=UrgentImportant
                            Color=@Colors.Red.Darken2
                            Title="DO - Urgent & Important" />
    </MudItem>

    <MudItem xs="12" md="6">
        <BoardItemsQuadrant Items=UnurgentImportant
                            Color=@Colors.Blue.Darken2
                            Title="PLAN - Not Urgent & Important" />
    </MudItem>

    <MudItem xs="12" md="6">
        <BoardItemsQuadrant Items=UrgentUnimportant
                            Color=@Colors.Orange.Darken2
                            Title="DELEGATE - Urgent & Not Important" />
    </MudItem>


    <MudItem xs="12" md="6">
        <BoardItemsQuadrant Items=UnurgentUnimportant
                            Color=@Colors.Lime.Darken1
                            Title="ELIMINATE - Not Urgent & Not Important" />
    </MudItem>
</MudGrid>
