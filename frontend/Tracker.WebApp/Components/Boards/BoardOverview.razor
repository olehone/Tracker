@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.BoardItems
@using Tracker.WebApp.Components.BoardLists
@using Tracker.WebApp.Components.Shared;
@using Tracker.WebApp.Components.Boards;

@if (BoardState.IsLoading)
{
	<MudStack Row
			  Justify="Justify.Center">
		<MudProgressCircular Indeterminate
							 Size=@Size.Large />
	</MudStack>
}
else
{
	<MudDropContainer @ref=@_container
					  T=@BoardItemDto
					  Items=@BoardState.Items.BoardItems
					  ItemsSelector=@((item, list) => item.BoardListId.ToString() == list)
					  ItemDropped=@ItemDropped
					  Class="d-flex flex-row flex-nowrap">
		<ChildContent>
			@foreach (var list in BoardState.Lists.BoardLists)
			{
				<BoardList List=@list />
			}
			@if (Board.Permissions.CanCreateList)
			{
				<MudPaper Elevation="5"
						  Width="400px"
						  Style="align-self: flex-start;"
						  Class="my-3 mx-2">
					<OneLineCreateButton Title="Add new list"
										 OnCreate=@CreateList />
				</MudPaper>
			}
		</ChildContent>

		<ItemRenderer>
			<BoardItem Item=@context />
		</ItemRenderer>
	</MudDropContainer>
}

