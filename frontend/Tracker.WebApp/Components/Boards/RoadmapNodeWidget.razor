@using Blazor.Diagrams.Components.Renderers
@using Blazor.Diagrams.Core.Models
@using Tracker.WebApp.Components.Items
@using MudBlazor

@*
    Port placement: each port is wrapped in an absolutely-positioned div that
    manually places it on its edge (old approach that actually works).
    `position: static !important` on .rn-port cancels the library's inline
    left/top overrides so our wrapper wins — but the library still reads
    getBoundingClientRect() for drawing links, so arrows snap correctly.

    Visibility: ports are hidden by default (opacity 0) and revealed either
    by hovering the card or while a link is being drawn (.rn-diagram-linking
    is toggled on the Roadmap container by _isLinking).
*@

<div class="rn-card">

    <div class="rn-title mx-2" @onpointerdown:stopPropagation="true">
        <ItemFull Item="@Node.Item" />
    </div>

    <div class="rn-port-wrap rn-port-top">
        <PortRenderer Port="@Node.GetPort(PortAlignment.Top)"    Class="rn-port" />
    </div>
    <div class="rn-port-wrap rn-port-bottom">
        <PortRenderer Port="@Node.GetPort(PortAlignment.Bottom)" Class="rn-port" />
    </div>
    <div class="rn-port-wrap rn-port-left">
        <PortRenderer Port="@Node.GetPort(PortAlignment.Left)"   Class="rn-port" />
    </div>
    <div class="rn-port-wrap rn-port-right">
        <PortRenderer Port="@Node.GetPort(PortAlignment.Right)"  Class="rn-port" />
    </div>

</div>

<style>
    /* ── Card ────────────────────────────────────────────────────────── */
    .rn-card {
        position: relative;            /* positioning context for port wrappers */
        display: flex;
        align-items: center;
        min-width: 260px;
        max-width: 320px;
        background: var(--mud-palette-surface, #ffffff);
        border: 1.5px solid var(--mud-palette-lines-default, #e0e0e0);
        border-radius: 10px;
        box-shadow: 0 2px 10px rgba(0,0,0,.10);
        transition: box-shadow .15s ease;
        overflow: visible;             /* ports bleed outside */
    }
    .rn-card:hover {
        box-shadow: 0 4px 18px rgba(0,0,0,.16);
    }

    /* ── Title ───────────────────────────────────────────────────────── */
    .rn-title {
        flex: 1;
        min-width: 0;
        padding: 4px 10px 4px 2px;
    }

    /* ── Port wrappers — one per edge ────────────────────────────────── */
    .rn-port-wrap {
        position: absolute;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 10;
        /* hide by default; revealed on hover or while linking */
        opacity: 0;
        pointer-events: none;
        transition: opacity .15s ease;
    }

    .rn-port-top    { top: -7px;    left: 50%;  transform: translateX(-50%); }
    .rn-port-bottom { bottom: -7px; left: 50%;  transform: translateX(-50%); }
    .rn-port-left   { left: -7px;   top: 50%;   transform: translateY(-50%); }
    .rn-port-right  { right: -7px;  top: 50%;   transform: translateY(-50%); }

    /* Show on hover */
    .rn-card:hover .rn-port-wrap {
        opacity: 1;
        pointer-events: auto;
    }

    /* Show on ALL nodes while a link is being drawn */
    .rn-diagram-linking .rn-port-wrap {
        opacity: 1;
        pointer-events: auto;
    }

    /* ── Port squares — cancel library's inline left/top overrides ───── */
    .rn-port {
        /* reset library positioning so our wrapper placement wins */
        position: static !important;
        left: auto !important;
        top: auto !important;
        /* visual */
        width: 13px !important;
        height: 13px !important;
        border-radius: 4px !important;
        background: var(--mud-palette-surface, #fff) !important;
        border: 2px solid var(--mud-palette-primary, #594ae2) !important;
        box-shadow: 0 0 0 3px rgba(89,74,226,.12) !important;
        cursor: crosshair !important;
        transition: background .12s ease, transform .12s ease !important;
    }
    .rn-port:hover {
        background: var(--mud-palette-primary, #594ae2) !important;
        transform: scale(1.45) !important;
    }
</style>

@code {
    [Parameter, EditorRequired]
    public RoadmapItemNode Node { get; set; } = null!;
}