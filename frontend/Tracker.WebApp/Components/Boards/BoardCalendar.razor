@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.BoardItems
@using Tracker.WebApp.Components.BoardLists
@using Tracker.WebApp.Components.Shared;
@using Tracker.WebApp.Components.Boards;
@using Heron.MudCalendar

@if (BoardState.IsLoading)
{
	<MudProgressLinear Color="Color.Primary"
					   Indeterminate />
}
else
{
	<MudStack Row>
		<MudCalendar T="CalendarItemWrapper"
					 ShowMonth
					 ShowDay="false"
					 ShowWeek="false"
					 ShowTodayButton
					 ShowCurrentTime
					 Items=@ItemsWithDate
					 ItemChanged=@OnItemChanged
					 EnableDragItems=@BoardState.Board.Permissions.CanChangeItem
					 MonthCellMinHeight="0">
			<CellTemplate>
				<BoardItemBrief Item=@context.Item
								Size="Size.Small" />
			</CellTemplate>
			<ToolbarContent>
				<MudStack Row>
					<MudToggleGroup T="bool"
									Value=@_showNotOwn
									ValueChanged=@OnNotOwnChanged
									Outlined
									Delimiters
									Disabled=@IsUnauthorized()>
						<MudToggleItem Value=true>
							All
						</MudToggleItem>

						<MudToggleItem Value=false>
							Assigned to me
						</MudToggleItem>
					</MudToggleGroup>

					<MudToggleGroup T="bool"
									Value=@_showNotCompleted
									ValueChanged=@OnNotCompletedChanged
									Outlined
									Delimiters>
						<MudToggleItem Value=true>
							All
						</MudToggleItem>

						<MudToggleItem Value="false">
							Not completed
						</MudToggleItem>
					</MudToggleGroup>
				</MudStack>
			</ToolbarContent>
		</MudCalendar>

		<BoardItemsList Items=@ItemsWithoutDate
						Title="Items without date" />
	</MudStack>
}