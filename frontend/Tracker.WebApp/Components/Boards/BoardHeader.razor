@using Tracker.WebApp.Components.BoardUsers
@using Tracker.WebApp.Components.Boards
@using Tracker.WebApp.Components.Call
@using Tracker.WebApp.Components.Items
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users
@using Tracker.WebApp.Shared

@inherits BoardSubscribeBase

<MudToolBar Dense Class=@($"mud-theme-{Color.Secondary.ToDescriptionString()}")>

    <MudTooltip Text="To workspace">
        <MudIconButton Href=@WorkspacePath()
                       Icon=@Icons.Material.Filled.KeyboardArrowLeft
                       Color="Color.Inherit" />
    </MudTooltip>
    <MudSpacer />

    <MudText Typo="Typo.h6"
             Color="Color.Inherit"
             Class="text-ellipsis">
        @Board.Title
    </MudText>

    <MudSpacer />

    @if (Board.CallId is not null)
    {
        <PeekingCall CallId=@(Board.CallId.Value)
                     OnEnded=BoardState.ApplyCallEnded
                     OnJoinPressed=OpenCall />
    }
    else
    {
        <MudButton OnClick=StartCall>
            Start call
        </MudButton>
    }

    <MudStack Row
              Spacing="3"
              AlignItems="AlignItems.Center">

        <MudTabs Elevation="0"
                 MinimumTabWidth="20px"
                 ActivePanelIndex=@TabIndex
                 ActivePanelIndexChanged=@OnTabIndexChanged
                 Color="Color.Secondary">
            <MudTabPanel Icon=@Icons.Material.Filled.Assessment Class="icon-rotate-180" ToolTip="Kanban" />
            <MudTabPanel Icon=@Icons.Material.Filled.CalendarToday ToolTip="Calendar" />
            <MudTabPanel Icon=@Icons.Material.Filled.BorderAll ToolTip="Eisenhower matrix" />
        </MudTabs>

        @if (Board.Permissions.CanChangeList && BoardState.ListsState.BoardLists.Count > 1)
        {
            <MudTooltip Text="Move lists">
                <MudIconButton Icon=@Icons.Material.Filled.SwapHoriz
                               Color="Color.Inherit"
                               OnClick=@OpenListsSwap />
            </MudTooltip>
        }
        @if (Board.Permissions.CanChangeBoard)
        {
            <MudTooltip Text="Members">
                <MudIconButton Icon=@Icons.Material.Outlined.People
                               Color="Color.Inherit"
                               OnClick=@OpenMembers />
            </MudTooltip>

            <MudTooltip Text="Settings">
                <MudIconButton Icon=@Icons.Material.Outlined.Settings
                               Color="Color.Inherit"
                               OnClick=@OpenSettings />
            </MudTooltip>
        }
        else
        {
            <MudTooltip Text="Information about board">
                <MudIconButton Icon=@Icons.Material.Outlined.Info
                               Color="Color.Inherit"
                               OnClick=@OpenSettings />
            </MudTooltip>
        }
    </MudStack>
</MudToolBar>		   