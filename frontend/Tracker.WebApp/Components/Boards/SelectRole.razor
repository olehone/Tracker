@using Tracker.Domain.Enums

<MudSelect Value=@Value
           ValueChanged=@ValueChanged
		   Label=@Label
		   Variant="Variant.Outlined">
	<MudSelectItem Value=@BoardPermissionRole.Any>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Public /> Anyone
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@BoardPermissionRole.Observer>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Hail /> Observers and higher
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@BoardPermissionRole.Member>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Group /> Members and higher
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@BoardPermissionRole.Admin>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Groups /> Admin and higher
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@BoardPermissionRole.Owner>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Person /> Owner only
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@BoardPermissionRole.None>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.PersonOff /> Nobody
		</MudStack>
	</MudSelectItem>
</MudSelect>