@using Tracker.WebApp.Shared

<MudCard Elevation="2"
         @onclick=@(OpenBoard)>
    <MudCardMedia Height="70"
                  Style=@(IsArchived ? $"background: {Colors.Gray.Lighten1};" : CustomColor)>
    </MudCardMedia>

    <MudCardContent>
        <MudStack Row
                  AlignItems="AlignItems.Center">
            <MudText Typo="Typo.h5"
                     Class="text-ellipsis">
                @Board.Title
            </MudText>

            <MudSpacer />

            @if (IsArchived)
            {
                <MudChip T="string"
                         Label="true"
                         Icon=@ArchiveStatusHelper.GetIcon(Board.ArchiveStatus)
                         Color=@ArchiveStatusHelper.GetColor(Board.ArchiveStatus)
                         Size="Size.Small">
                    @Board.ArchiveStatus.ToString()
                </MudChip>
            }
            else
            {
                <MudStack Row>
                    <BoardVisibilityIcon Visibility=@Board.Visibility />
                    @if (Board.IsParticipating)
                    {
                        <MudTooltip Text="You are member of this board">
                            <MudIcon Icon="@Icons.Material.Outlined.Star" Color="Color.Warning" />
                        </MudTooltip>
                    }
                </MudStack>
            }
        </MudStack>
    </MudCardContent>
</MudCard>