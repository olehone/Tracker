@using Tracker.WebApp.Shared

<a href=@($"/boards/{Board.Id}")>
	<MudCard Elevation="2">
		<MudCardMedia Height="70"
					  Style=@CustomColor>
		</MudCardMedia>

		<MudCardContent>
			<MudStack Row
					  Justify="Justify.SpaceBetween">
				<MudText Typo="Typo.h5"
						 Class="text-ellipsis">
					@Board.Title
				</MudText>

				<MudStack Row>
					<BoardVisibilityIcon Visibility=@Board.Visibility/>
					@if (Board.IsParticipating)
					{
						<MudTooltip Text="You are member of this board">
							<MudIcon Icon="@Icons.Material.Outlined.Star" Color="Color.Warning" />
						</MudTooltip>
					}
				</MudStack>
			</MudStack>
		</MudCardContent>
	</MudCard>
</a>

