@using Tracker.Domain.Enums

<MudSelect Value=@Value
		   ValueChanged=@ValueChanged
		   Label=@Label
		   Dense
		   Variant="Variant.Outlined">
	<MudSelectItem Value=@UserBoardRole.Observer>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Visibility /> Observer
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@UserBoardRole.Member>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.Person /> Member
		</MudStack>
	</MudSelectItem>

	<MudSelectItem Value=@UserBoardRole.Admin>
		<MudStack Row>
			<MudIcon Icon=@Icons.Material.Filled.AdminPanelSettings /> Admin
		</MudStack>
	</MudSelectItem>
	@if (Owner is not null)
	{
		@Owner
	}
</MudSelect>