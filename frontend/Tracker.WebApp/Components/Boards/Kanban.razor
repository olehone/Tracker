@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Boards;
@using Tracker.WebApp.Components.Items
@using Tracker.WebApp.Components.Lists
@using Tracker.WebApp.Components.Shared;

@inherits ListItemSubscribeBase

<MudDropContainer @ref=@_container
				  T=@BoardItemDto
				  ItemDisabled=@ItemDisabled
				  Items=@BoardState.ItemsState.BoardItems
				  ItemsSelector=@((item, list) => item.BoardListId.ToString() == list)
				  ItemDropped=@ItemDropped
				  Style="overflow-x: auto; height:100%; display: inline-flex;">
	<ChildContent>
		@foreach (var list in BoardState.ListsState.BoardLists)
		{
			<DropList List=@list />
		}
		@if (Board.Permissions.CanCreateList)
		{
				<OneLineCreateButton Title="Add new list"
									 OnCreate=@CreateList />
		}
	</ChildContent>

	<ItemRenderer>
		<ItemFull Item=@context />
	</ItemRenderer>
</MudDropContainer>
