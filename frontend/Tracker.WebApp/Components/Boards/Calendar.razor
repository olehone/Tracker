@using Heron.MudCalendar
@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Boards;
@using Tracker.WebApp.Components.Items
@using Tracker.WebApp.Components.Lists
@using Tracker.WebApp.Components.Shared;

<MudStack Row>
	<MudCalendar T="CalendarItemWrapper"
				 ShowMonth
				 ShowDay="false"
				 ShowWeek="false"
				 ShowTodayButton
				 ShowCurrentTime
				 Items=@ItemsWithDate
				 ItemChanged=@OnItemChanged
				 EnableDragItems=@BoardState.Board.Permissions.CanChangeItem
				 MonthCellMinHeight="0">
		<CellTemplate>
			<ItemBrief Item=@context.Item
							Size="Size.Small" />
		</CellTemplate>
		<ToolbarContent>
			<MudStack Row>
				<MudToggleGroup T="bool"
								Value=@_showNotOwn
								ValueChanged=@OnNotOwnChanged
								Outlined
								Delimiters
								Disabled=@IsUnauthorized()>
					<MudToggleItem Value=true>
						All
					</MudToggleItem>

					<MudToggleItem Value=false>
						Assigned to me
					</MudToggleItem>
				</MudToggleGroup>

				<MudToggleGroup T="bool"
								Value=@_showNotCompleted
								ValueChanged=@OnNotCompletedChanged
								Outlined
								Delimiters>
					<MudToggleItem Value=true>
						All
					</MudToggleItem>

					<MudToggleItem Value="false">
						Not completed
					</MudToggleItem>
				</MudToggleGroup>
			</MudStack>
		</ToolbarContent>
	</MudCalendar>

	<ItemsList Items=@ItemsWithoutDate
					Title="Items without date" />
</MudStack>
