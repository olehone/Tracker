@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Users
@using Tracker.WebApp.States

<MudPaper Class="pa-2" Style="width: 400px; max-width: 90vw;">
	<MudStack Row
			  AlignItems="AlignItems.Center"
			  Justify="Justify.SpaceBetween">

		<MudText Typo="Typo.h6">
			Assign
		</MudText>

		<MudIconButton Icon=@Icons.Material.Filled.Close
					   OnClick=@Close />
	</MudStack>
	<MudTextField @bind-Value=Search
				  Placeholder="Search"
				  DebounceInterval="500"
				  Variant="Variant.Outlined" />
	<MudPaper Elevation="0"
			  Style="max-height: 400px; overflow-y: auto;"
			  Class="pa-2">
		@if (AssignedUsers.Any())
		{
			<MudText Typo="Typo.body2">
				Assigned
			</MudText>

			@foreach (var user in AssignedUsers)
			{
				<MudStack @key=@user.Id
						  Row
						  Justify="Justify.SpaceBetween"
						  AlignItems="AlignItems.Center">
					<BriefUserInfo User=@user />

					<MudIconButton Icon=@Icons.Material.Filled.Close
								   OnClick=@(() => BoardState.ItemsState.UnassignAsync(Item.Id, user.Id)) />
				</MudStack>
			}
		}
		@if (UnassignedUsers.Any())
		{
			<MudText Typo="Typo.body2">
				Available users in board
			</MudText>
			@foreach (var user in UnassignedUsers)
			{
				<MudButton @key=@user.Id
						   FullWidth
						   Class="justify-start"
						   OnClick=@(() => BoardState.ItemsState.AssignAsync(Item.Id, user.Id))>
					<BriefUserInfo User=@user />
				</MudButton>
			}
		}
	</MudPaper>
</MudPaper>