@using Tracker.Domain.Dtos
@using Tracker.Domain.Enums
@using Tracker.WebApp.Components.Attachments
@using Tracker.WebApp.Components.BoardUsers
@using Tracker.WebApp.Components.ItemComments
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users

<CascadingValue Value=@BoardState>
    @if (IsItemExists)
    {
        <MudDialog>
            <DialogContent>
                <MudStack>
                    <MudGrid>
                        <MudItem xs="12">
                            <ItemSettingsHeader Item=@Item />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            @if (!Disabled)
                            {
                                <MudStack Row>
                                    @if (!Item.Assignees.Any())
                                    {
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   StartIcon=@Icons.Material.Filled.PersonAdd
                                                   OnClick=@ToggleAssign>
                                            Assign
                                        </MudButton>
                                    }
                                    @if (_date is null && !_openDate)
                                    {
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   StartIcon=@Icons.Material.Filled.EditCalendar
                                                   OnClick=@(() => _openDate = true)>
                                            Set due date
                                        </MudButton>
                                    }
                                    @if (IsMeBoardUser && !IsMeAssigned)
                                    {
                                        <MudButton Size="Size.Small"
                                                   Variant="Variant.Outlined"
                                                   StartIcon=@Icons.Material.Filled.PersonAdd
                                                   OnClick=@(() =>BoardState.ItemsState.AssignAsync(Item.Id, AppState.MyId))>
                                            Assign myself
                                        </MudButton>
                                    }
                                </MudStack>

                                @if (_openAssign)
                                {
                                    <MudOverlay Visible="true"
                                                AutoClose="true"
                                                OnClosed=@(() => _openAssign = false)
                                                DarkBackground="false" />

                                    <MudPopover Open
                                                AnchorOrigin="Origin.TopRight"
                                                TransformOrigin="Origin.CenterRight">
                                        <ItemAssignees BoardState=@BoardState
                                                       Close=@(() => _openAssign = false)
                                                       Item=@Item />
                                    </MudPopover>
                                }
                            }

                            <ItemAssigneesList Item=@Item
                                               Disabled=@Disabled
                                               ToggleAssign=@ToggleAssign
                                               OpenAssign=@_openAssign />
                            <MudStack Row
                                      AlignItems="AlignItems.Center"
                                      StretchItems="StretchItems.None">
                                @if (_date is not null || _openDate)
                                {
                                    <MudStack Spacing="0" Class="mud-width-full">
                                        <MudText Typo="Typo.body2">
                                            Due date
                                        </MudText>

                                        <MudStack Row
                                                  AlignItems="AlignItems.Center">
                                            <MudDatePicker Date=@_date
                                                           Disabled=@Disabled
                                                           DateChanged=@((DateTime? date) => DateSelected(date))
                                                           ShowToolbar="false" />

                                            <MudIconButton Icon=@Icons.Material.Filled.Close
                                                           OnClick=@RemoveDueDate />
                                        </MudStack>
                                    </MudStack>
                                }
                                <MudStack Spacing="0" Class="mud-width-full">
                                    <MudText Typo="Typo.body2">
                                        Importance
                                    </MudText>

                                    <MudSelect FullWidth
                                               Value=@_importance
                                               ValueChanged=@((BoardItemImportance importance) => ImportanceSelected(importance))>
                                        @foreach (BoardItemImportance importance in Enum.GetValues(typeof(BoardItemImportance)))
                                        {
                                            <MudSelectItem Value=@importance
                                                           Disabled=@Disabled>
                                                <MudStack Row
                                                          Justify="Justify.SpaceBetween"
                                                          StretchItems="StretchItems.End">
                                                    <MudIcon Icon=@ImportanceHelper.GetIcon(importance)
                                                             Color=@ImportanceHelper.GetColor(importance) />

                                                    <MudText>
                                                        @importance
                                                    </MudText>
                                                </MudStack>
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudStack>

                            </MudStack>

                            <MudTextField @bind-Value=@_description
                                          Disabled=@Disabled
                                          Label="Description"
                                          Variant="Variant.Outlined"
                                          AutoGrow
                                          @onfocus=@StartEditingDescription
                                          @onblur=@FinishEditingDescription />
                        </MudItem>

                        <MudItem xs="12" md="6">
                            <ItemAttachments Attachments=@_attachments
                                             Disabled=@Disabled
                                             UploadAsync=@UploadAttachmentAsync />
                        </MudItem>

                        <MudItem xs="12">
                            <ItemCommentsSection @ref=@_commentsRef
                                                 ItemId=@Item.Id
                                                 IsFileValid=@IsFileValid
                                                 MaxAttachmentSizeBytes=@MaxAttachmentSizeBytes
                                                 Disabled=@Disabled />
                        </MudItem>
                    </MudGrid>
                </MudStack>
            </DialogContent>
        </MudDialog>
    }
    else
    {
        <ErrorDialog Message="This item is no longer exists" />
    }
</CascadingValue>