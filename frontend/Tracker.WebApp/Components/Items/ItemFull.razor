@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users

<MudPaper Elevation=@GetElevation()
		  Class="pa-0 rounded-lg my-2">
	<MudButton FullWidth
			   Style="background-color: inherit; box-shadow: none;"
			   OnClick=@OpenItemSettings>
		<MudPaper Width="100%" Elevation="0">
			@if (OneLine)
			{
				<MudStack Row
						  AlignItems="AlignItems.Center"
						  StretchItems="StretchItems.Middle">
					<MudCheckBox T=@bool
								 Value=@Item.IsDone
								 ValueChanged=@OnIsDoneChanged />

					<MudText Class="text-ellipsis"
							 Style="@ItemStyle">
						@Item.Title
					</MudText>

					<MudSpacer />


					<MudAvatarGroup @key=@GetUsersKey()
									Max="3"
									Spacing="3">
						@foreach (var user in AssignedUsers())
						{
							<UserAvatarWithLookup User=@user.User
												  Size=@Size.Medium />
						}
					</MudAvatarGroup>

					<MudSpacer />

					@if (Item.DueDate is not null)
					{
						<ShortDate Value=@Item.DueDate.Value
								   IsDone=@Item.IsDone
								   HasAttention=@IsOwn() />
					}
					<ItemImportanceIcon Importance=@Item.Importance
											 HasAttention=@IsOwn() />
				</MudStack>
			}
			else
			{
				<MudStack Row
						  AlignItems="AlignItems.Center"
						  StretchItems="StretchItems.Middle">
					<MudCheckBox T=@bool
								 Value=@Item.IsDone
								 ValueChanged=@OnIsDoneChanged />

					<MudText Class="text-ellipsis"
							 Style="@ItemStyle">
						@Item.Title
					</MudText>

					<ItemImportanceIcon Importance=@Item.Importance
											 HasAttention=@IsOwn() />
				</MudStack>
				<MudStack Row>
					<MudAvatarGroup @key=@GetUsersKey()
									Max="3"
									Spacing="3">
						@foreach (var user in AssignedUsers())
						{
							<UserAvatarWithLookup User=@user.User
												  Size=@Size.Medium />
						}
					</MudAvatarGroup>

					<MudSpacer />

					@if (Item.DueDate is not null)
					{
						<ShortDate Value=@Item.DueDate.Value
								   IsDone=@Item.IsDone
								   HasAttention=@IsOwn() />
					}
				</MudStack>
			}
		</MudPaper>
	</MudButton>
</MudPaper>