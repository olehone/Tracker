@using Heron.MudCalendar
@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Boards;
@using Tracker.WebApp.Components.Items
@using Tracker.WebApp.Components.Lists
@using Tracker.WebApp.Components.Shared;

@if (OnlyTitle)
{
	<MudChip T="string"
			 Label="true"
			 Size=@Size
			 OnClick=@OpenItemSettings
			 Style="width: 90%">
		@Item.Title
	</MudChip>
}
else
{
	<MudButton Size=@Size
			   Color=@GetColor()
			   Variant=@GetVariant()
			   OnClick=@OpenItemSettings
			   Style=@GetStyle()
			   Class="ma-1">

		<ItemImportanceIcon Importance=@Item.Importance
							HasAttention=@IsOwn() />
		<MudSpacer />
		<MudText Class="text-ellipsis">
			@Item.Title
		</MudText>
	</MudButton>
}