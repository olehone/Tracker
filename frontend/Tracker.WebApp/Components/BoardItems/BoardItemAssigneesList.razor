@using Tracker.WebApp.Components.BoardUsers
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users

@if (Item.Assignees.Any())
{
	<MudStack Spacing="0">
		<MudText Typo="Typo.body2">
			Assigned users
		</MudText>

		<MudStack Row
				  Wrap="Wrap.Wrap"
				  Spacing="1">
			@foreach (var user in AssignedUsers())
			{
				@if (Disabled)
				{
					<UserAvatarWithLookup @key=@user.Id
									  User=@user
					Size="Size.Medium"/>
				}
				else
				{
					<UserAvatarWithLookup @key=@user.Id
										  User=@user
										  Size="Size.Medium">
						<AdditionalActions>
							<MudButton OnClick=@(() => BoardState.ItemsState.UnassignAsync(Item.Id, user.Id))>
								Unassign user from this item
							</MudButton>
						</AdditionalActions>
					</UserAvatarWithLookup>
				}
			}
			@if (!Disabled)
			{
				<MudAvatar Color=@(OpenAssign? Color.Info : Color.Surface )
							Variant=@(OpenAssign? Variant.Filled : Variant.Text)>
					<MudIconButton Icon=@Icons.Material.Filled.Add
									OnClick=@ToggleAssign/>
				</MudAvatar>
			}
		</MudStack>
	</MudStack>
}