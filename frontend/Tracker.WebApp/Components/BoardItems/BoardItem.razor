<MudPaper Elevation="25" Class="pa-0 rounded-lg my-3">
	<MudButton FullWidth
			   OnClick="@OpenItemSettings">
		<MudStack Row
				  Justify="Justify.SpaceBetween"
				  AlignItems="AlignItems.Center">

			<MudCheckBox T=@bool
						 Value="Item.IsDone"
						 ValueChanged="OnIsDoneChanged" />

			<MudText Style="@ItemStyle">
				@Item.Title
			</MudText>
		</MudStack>
	</MudButton>
</MudPaper>