@using Tracker.WebApp.Components.Users
<MudPaper Elevation="25" Class="pa-0 rounded-lg my-3">
	<MudButton FullWidth
			   OnClick="@OpenItemSettings">
		<MudCheckBox T=@bool
					 Value="Item.IsDone"
					 ValueChanged="OnIsDoneChanged" />

		<MudSpacer />

		<MudText Style="@ItemStyle">
			@Item.Title
		</MudText>

		<MudSpacer />

		<MudAvatarGroup Max="5"
						Spacing="4">
			@foreach (var user in AssignedUsers())
			{
				<UserAvatarSmall User=@user.User />
			}
		</MudAvatarGroup>
	</MudButton>
</MudPaper>