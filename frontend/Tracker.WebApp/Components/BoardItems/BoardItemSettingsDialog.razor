<CascadingValue Value="BoardState">
	<MudDialog>
		<DialogContent>
			<MudForm @ref=@_form
					 Model=@model
					 Validation=@validator
					 ValidationDelay="300">
				<MudStack Row
						  AlignItems="AlignItems.Center">
					<MudCheckBox @bind-Value=@model.IsDone
								 Size="Size.Large"></MudCheckBox>

					<MudTextField @bind-Value=@model.Title
								  Label="Title"
								  Required
								  Variant="Variant.Outlined"
								  Style=@Style() />
				</MudStack>

				<MudTextField @bind-Value=@model.Description
							  Label="Description"
							  Lines="3"
							  Variant="Variant.Outlined" />

			</MudForm>

			<MudDivider />

			<MudButton Variant="Variant.Filled"
					   Color="Color.Error"
					   FullWidth
					   OnClick=@Delete>Delete</MudButton>
		</DialogContent>
		<DialogActions>
			<MudButton OnClick="Cancel">
				<MudText>Cancel</MudText>
			</MudButton>

			<MudButton Disabled=@(isSubmitting)
					   OnClick=@Submit
					   Variant="Variant.Filled"
					   Color="Color.Primary">
				@if (isSubmitting)
				{
					<MudProgressCircular Size="Size.Small"
										 Indeterminate
										 Color="Color.Inherit" />
				}
				else
				{
					<MudText>Save</MudText>
				}
			</MudButton>
		</DialogActions>
	</MudDialog>
</CascadingValue>