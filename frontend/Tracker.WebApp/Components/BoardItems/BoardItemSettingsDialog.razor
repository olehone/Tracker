@using Tracker.WebApp.Components.BoardUsers
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users

<CascadingValue Value=@BoardState>
	@if (isExists)
	{
		<MudForm @ref=@_form
				 Model=@model
				 Validation=@validator
				 ValidationDelay="300">
			<MudDialog>
				<DialogContent>
					<MudStack>
						<MudStack Row
								  Justify="Justify.SpaceBetween"
								  AlignItems="AlignItems.Center">
							<MudStack Row
									  AlignItems="AlignItems.Center"
									  StretchItems="StretchItems.End">
								<MudCheckBox @bind-Value=@model.IsDone
											 Size="Size.Large"></MudCheckBox>

								<MudTextField @bind-Value=@model.Title
											  Typo="Typo.h5"
											  Required
											  Underline=false
											  Variant="Variant.Text"
											  Style=@Style() />
							</MudStack>
							<MudStack Row
									  AlignItems="AlignItems.Center">
								<MudMenu Icon=@Icons.Material.Filled.MoreVert
										 AriaLabel="Open item menu">
									<MudMenuItem Label="Delete"
												 OnClick=@Delete />
								</MudMenu>
								<MudIconButton Icon=@Icons.Material.Filled.Close
											   OnClick=@Cancel />
							</MudStack>
						</MudStack>

						<MudStack Row>
							@if (!Item.Assignees.Any())
							{
								<MudButton Size="Size.Small"
										   Variant="Variant.Outlined"
										   StartIcon=@Icons.Material.Filled.PersonAdd
										   OnClick=@ToggleAssign>
									Assign
								</MudButton>
								<MudPopover Open=@_openAssign
											AnchorOrigin="Origin.BottomCenter"
											TransformOrigin="Origin.TopCenter">
									<BoardUserSelect BoardState=@BoardState
													 Close=@(() => _openAssign = false) />
								</MudPopover>
							}

						</MudStack>

						@if (!Item.Assignees.Any())
						{
							<MudStack Row
									  Wrap="Wrap.Wrap">
							</MudStack>
						}
						<MudTextField @bind-Value=@model.Description
									  Label="Description"
									  Lines="3"
									  Variant="Variant.Outlined" />
						<MudButton Disabled=@(isSubmitting)
								   OnClick=@Submit
								   Variant="Variant.Filled"
								   Color="Color.Primary">
							@if (isSubmitting)
							{
								<MudProgressCircular Size="Size.Small"
													 Indeterminate
													 Color="Color.Inherit" />
							}
							else
							{
								<MudText>Save</MudText>
							}
						</MudButton>

						<MudAvatarGroup>
							@foreach (var assignee in Item.Assignees)
							{
							}
						</MudAvatarGroup>
						<MudDivider />

					</MudStack>
				</DialogContent>
			</MudDialog>
		</MudForm>
	}
	else
	{
		<ErrorDialog Message="This item is no longer exists" />
	}
</CascadingValue>