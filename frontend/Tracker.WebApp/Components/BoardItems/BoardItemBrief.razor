@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.BoardItems
@using Tracker.WebApp.Components.BoardLists
@using Tracker.WebApp.Components.Shared;
@using Tracker.WebApp.Components.Boards;
@using Heron.MudCalendar

@if (OnlyTitle)
{
	<MudChip T="string"
			 Label="true"
			 Size=@Size
			 OnClick=@OpenItemSettings
			 Style="width: 90%">
		@Item.Title
	</MudChip>
}
else
{
	<MudChip T="string"
			 Label="true"
			 Size=@Size
			 Icon=@ImportanceHelper.GetIcon(Item.Importance)
			 Color=@GetColor()
			 Variant=@GetVariant()
			 OnClick=@OpenItemSettings
			 Style=@GetStyle()>
		@Item.Title
	</MudChip>
}