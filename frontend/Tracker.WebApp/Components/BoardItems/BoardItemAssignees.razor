@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Users
@using Tracker.WebApp.States

<MudPaper Class="pa-2">
	<MudStack>
		<MudStack Row
				  AlignItems="AlignItems.Center"
				  Justify="Justify.SpaceBetween">
			<MudText Typo="Typo.h6">
				Assign
			</MudText>
			<MudIconButton Icon=@Icons.Material.Filled.Close
						   OnClick=@Close />
		</MudStack>
		<MudTextField @bind-Value=Search
					  Placeholder="Search"
					  DebounceInterval="500"
					  Variant="Variant.Outlined" />
		@if (AssignedUsers.Any())
		{
			<MudText Typo="Typo.body2">
				Assigned
			</MudText>
			@foreach (var user in AssignedUsers)
			{
				<MudStack Row
						  Justify="Justify.SpaceBetween">
					<SmallUserInfo User=@user.User />
					<MudIconButton Icon=@Icons.Material.Filled.Close />
				</MudStack>
			}
		}

		@if (UnassignedUsers.Any())
		{
			<MudText Typo="Typo.body2">
				Available users in board
			</MudText>
			@foreach (var user in UnassignedUsers)
			{
				<MudButton FullWidth
						   Class="justify-start"
						   OnClick=@(() => BoardState.ItemsState.AssignAsync(Item.Id, user.User.Id))>
					<MudStack Row
							  AlignItems="AlignItems.Start">
						<SmallUserInfo User=@user.User />
					</MudStack>
				</MudButton>
			}
		}
	</MudStack>
</MudPaper>