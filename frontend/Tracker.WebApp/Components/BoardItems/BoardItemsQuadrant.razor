@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.BoardItems

<MudPaper Elevation="3"
		  Class="pa-3"
		  Style="min-width: 300px; flex: 1 1 calc(50% - 12px); height: 320px; display: flex; flex-direction: column;">

	<MudText Typo="Typo.h6"
			 Align="Align.Center"
			 Class="mb-3"
			 Style=@($"color: {Color}")>
		@Title
	</MudText>
	<MudStack Style="flex: 1; overflow-y: auto;"
			  Class="pa-2 ma-2 mud-background-gray rounded mud-elevation-3"
			  Spacing="1">
		@if (Items.Any())
		{
			@foreach (var item in Items)
			{
				<BoardItem Item=@item />
			}
		}
		else
		{
			<MudText Typo="Typo.body2"
					 Align="Align.Center"
					 Class="mt-4">
				No items
			</MudText>
		}
	</MudStack>

	<MudText Typo="Typo.caption"
			 Align="Align.Right"
			 Class="mt-2">
		@Items.Count item@(Items.Count != 1 ? "s" : "")
	</MudText>
</MudPaper>
