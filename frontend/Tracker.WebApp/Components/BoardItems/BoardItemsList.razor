@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Shared

<MudPaper Elevation="5"
		  Width="400px"
		  Class="my-3 mx-2">
	<MudStack Justify="Justify.Center">
		<MudText Typo="Typo.h5"
				 Class="ma-3">
			@Title
		</MudText>
	</MudStack>

	<MudPaper MinHeight="60px" MaxHeight="90%"
			  Elevation="3"
			  Style="overflow-y: auto;"
			  Class="pa-2 ma-2 mud-background-gray">
		@foreach (var item in Items)
		{
			<BoardItemBrief Item=@item 
				Size="Size.Large"/>
		}
	</MudPaper>
</MudPaper>