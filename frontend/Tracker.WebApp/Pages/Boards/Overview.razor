@page "/boards/{BoardId:guid}"

@using Microsoft.AspNetCore.Components.Routing
@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Boards;
@using Tracker.WebApp.Components.Items
@using Tracker.WebApp.Components.Lists
@using Tracker.WebApp.Components.Shared;

<PageTitle>@PageTitle()</PageTitle>


@if (BoardState.IsLoading)
{
	<MudItem xs="12">
		<BoardHeaderSkeleton />
	</MudItem>
}
else
{
	<CascadingValue Value=@BoardState>
		<BoardHeader @bind-TabIndex=@activeIndex />
		@switch (activeIndex)
		{
			case 0:
				<Kanban />
				break;
			case 1:
				<Calendar />
				break;
			case 2:
				<Eisenhower />
				break;
			default:
				<MudAlert Severity="Severity.Error">
					There no such index!
				</MudAlert>
				break;
		}
	</CascadingValue>
}
