@page "/boards/{BoardId:guid}"

@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.BoardItems
@using Tracker.WebApp.Components.BoardLists
@using Tracker.WebApp.Components.Shared;
@using Tracker.WebApp.Components.Boards;

<PageTitle>@PageTitle()</PageTitle>
<CascadingValue Value=@BoardState>
	<WorkWindow>

		<Header>
			<BoardWindowHeader @bind-TabIndex=@activeIndex />
		</Header>

		<Body>
			@if (BoardState.IsLoading)
			{
				<MudProgressLinear Color="Color.Primary"
								   Indeterminate />
			}
			else
			{
				@switch (activeIndex)
				{
					case 0:
						<MudStack StretchItems="StretchItems.None"
								  AlignItems="AlignItems.Start"
								  Style="overflow-x: auto;">
							<BoardKanban />
						</MudStack>
						break;
					case 1:
						<BoardCalendar />
						break;
					case 2:
						<MudText>Matrix</MudText>
						break;
					default:
						<MudAlert Severity="Severity.Error">
							There no such index!
						</MudAlert>
						break;
				}

			}
		</Body>
	</WorkWindow>
</CascadingValue>