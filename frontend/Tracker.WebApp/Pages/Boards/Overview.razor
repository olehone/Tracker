@page "/boards/{BoardId:guid}"

@using Microsoft.AspNetCore.Components.Routing
@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Boards;
@using Tracker.WebApp.Components.Items
@using Tracker.WebApp.Components.Lists
@using Tracker.WebApp.Components.Shared;

<PageTitle>@PageTitle()</PageTitle>

@if (BoardState.IsLoading)
{
	<WorkWindow>
		<Header>
			<BoardWindowHeaderSkeleton />
		</Header>
		<Body>
			<MudProgressLinear Color="Color.Primary"
							   Indeterminate />
			<div />
		</Body>
	</WorkWindow>
}
else
{
	<CascadingValue Value=@BoardState>

		<WorkWindow>
			<Header>
				<BoardWindowHeader @bind-TabIndex=@activeIndex />
			</Header>
			<Body>
				@switch (activeIndex)
				{
					case 0:
						<MudStack StretchItems="StretchItems.None"
								  AlignItems="AlignItems.Start"
								  Style="overflow-x: auto;">
							<Kanban />
						</MudStack>
						break;
					case 1:
						<Calendar />
						break;
					case 2:
						<Eisenhower />
						break;
					default:
						<MudAlert Severity="Severity.Error">
							There no such index!
						</MudAlert>
						break;
				}
			</Body>
		</WorkWindow>
	</CascadingValue>
}