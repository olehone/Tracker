@page "/admin/users"

@using Microsoft.AspNetCore.Authorization
@using Tracker.WebApp.Components.Shared
@using Tracker.Domain.Dtos
@using Tracker.WebApp.Components.Users

@attribute [Authorize(Policy = "AdminOrHigher")]

<MudContainer MaxWidth="MaxWidth.Large"
			  Class="mt-4">
	<ServerLoadingTable TItem=@UserDto
						@ref=@_table
						DataProvider=@LoadUsers>

		<Toolbar>
			<MudText Typo="Typo.h6">Users</MudText>
			<MudSpacer />
			<MudTextField T="string"
						  ValueChanged=@(s => OnSearchChanged(s))
						  TextUpdateSuppression="false"
						  Placeholder="Search username"
						  DebounceInterval="500"
						  Adornment="Adornment.Start"
						  AdornmentIcon="@Icons.Material.Filled.Search" />
		</Toolbar>

		<Header>
			<MudTh>Avatar</MudTh>
			<MudTh>Username</MudTh>
			<MudTh>Email</MudTh>
			<MudTh>Name</MudTh>
			<MudTh>Role</MudTh>
			<MudTh>Profile</MudTh>
		</Header>

		<Row Context="User">
			@if (User is not null)
			{
				<MudTd>
					<UserAvatar User=@User
								Size="Size.Small" />
				</MudTd>

				<MudTd Class="text-ellipsis"
					   Style="max-width:20vw">
					@User.Username
				</MudTd>
				<MudTd Class="text-ellipsis"
					   Style="max-width:20vw">
					@User.Email
				</MudTd>
				<MudTd Class="text-ellipsis"
					   Style="max-width:20vw">
					@User.FirstName @User.LastName
				</MudTd>
				<MudTd>
					<RoleChip Role=@User.Role />
				</MudTd>
				<MudTd>
					<a href=@($"/users/{User!.Id}")>
						<MudIcon Icon="@Icons.Material.Filled.OpenInNew"
								 Size="Size.Small"
								 Color="Color.Primary" />
					</a>
				</MudTd>
			}
		</Row>

	</ServerLoadingTable>
</MudContainer>