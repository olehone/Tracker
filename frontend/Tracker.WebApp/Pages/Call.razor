@page "/"

<div class="container">
    <div class="camerabox">
        <video id="local_video" autoplay muted></video>
        @foreach (var userId in _remoteUsers)
        {
            <div>
                <video id="video-@userId" autoplay></video>
                <p>@userId</p>
            </div>

        }
        <button id="hangup-button"
                @onclick=@HangUpCall
                role="button"
                disabled>
            Hang Up
        </button>
    </div>
    <div class="empty-container"></div>
</div>


