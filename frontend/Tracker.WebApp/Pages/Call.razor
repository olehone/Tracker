@page "/call"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Tracker.WebApp.Components.Call

@attribute [Authorize]

@if (CallState.IsInCall)
{
    <div class="container">
        <!-- Local camera tile -->
        <div class="local-tile">
            <video id="local_video" autoplay muted
                   style="width:160px;height:120px;object-fit:cover;">
            </video>
            <span class="local-tile__label">You</span>
        </div>

        <!-- Local screen preview (own share) -->
        @if (CallState.IsSharingLocalScreen)
        {
            <div class="screen-tile screen-tile--local">
                <video id="local_screen" autoplay muted
                       style="width:160px;height:120px;object-fit:cover;">
                </video>
                <span class="screen-tile__label">Your screen</span>
            </div>
        }

        <!-- Remote camera tiles — sorted by userId for stable order -->
        @foreach (var userId in CallState.RemoteUsers)
        {
            var state = CallState.PeerStates.GetValueOrDefault(userId);
            var isExpanded = CallState.ExpandedUserId == userId;

            <div class="remote-tile @(isExpanded ? "remote-tile--expanded" : "")"
                 @key="userId"
                 @onclick="() => CallState.SetExpandedUser(isExpanded ? null : userId)">
                <video id="video-@userId"
                       autoplay
                       style="width:@(isExpanded ? "100%" : "160px");height:@(isExpanded ? "100%" : "120px");object-fit:cover;"
                       class="@(state is { Video: false } ? "video--off" : "")">
                </video>
                <div class="remote-tile__indicators">
                    @if (state is { Audio: false })
                    {
                        <span class="indicator indicator--muted" title="Muted">🔇</span>
                    }
                </div>
            </div>
        }

        <!-- Remote screen shares -->
        @foreach (var userId in CallState.RemoteScreenUsers)
        {
            <div class="screen-tile" @key="@($"screen-{userId}")">
                <video id="screen-@userId" autoplay
                       style="width:160px;height:120px;object-fit:cover;">
                </video>
            </div>
        }

        <!-- Device settings -->
        @if (_showDeviceSettings)
        {
            <div class="device-panel device-panel--incall">
                <DeviceSelector />
            </div>
        }

        <!-- Controls -->
        <div class="controls">
            <button class="control-btn @(CallState.IsMuted ? "control-btn--active" : "")"
                    @onclick="() => CallState.ToggleMuteAsync()"
                    title="@(CallState.IsMuted ? "Unmute" : "Mute")">
                @(CallState.IsMuted ? "🔇" : "🎤")
            </button>

            <button class="control-btn @(!CallState.IsVideoEnabled ? "control-btn--active" : "")"
                    @onclick="() => CallState.ToggleVideoAsync()"
                    title="@(CallState.IsVideoEnabled ? "Turn off camera" : "Turn on camera")">
                @(CallState.IsVideoEnabled ? "📷" : "🚫")
            </button>

            <button class="control-btn @(CallState.IsSharingScreen ? "control-btn--active" : "")"
                    @onclick="() => CallState.ToggleScreenShareAsync()"
                    title="@(CallState.IsSharingScreen ? "Stop sharing" : "Share screen")">
                🖥
            </button>

            <button class="control-btn @(_showDeviceSettings ? "control-btn--active" : "")"
                    @onclick="() => _showDeviceSettings = !_showDeviceSettings"
                    title="Audio & video settings">
                ⚙️
            </button>

            <button class="control-btn control-btn--hangup"
                    @onclick="() => CallState.HangUpAsync()"
                    title="Leave call">
                📵
            </button>
        </div>
    </div>
}