@page "/call"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Tracker.WebApp.Components.Call
@using Tracker.WebApp.Components.Shared
@using MudBlazor

<LoadingWrapper LoadingCondition=@AppState.IsUnauthenticated>
    <Content>
        <MudStack Justify="Justify.Center"
                  StretchItems="StretchItems.Middle"
                  AlignItems="AlignItems.Center"
                  Class="mud-height-full">
            <MudStack Row
                      Justify="Justify.Center"
                      AlignItems="AlignItems.Center"
                      Style="overflow-x:auto; height:20vh"
                      Class="mud-width-full">

                @if (ExpandedVideoId != "local_video")
                {
                    <VideoWrap Id="local_video"
                               IsCameraOff="@(!CallState.IsVideoEnabled)"
                               IsMuted="@CallState.IsMuted"
                               IsOwn
                               OnClick=@(EventCallback.Factory.Create<string>(this, ExpandVideo)) />
                }

                @if (CallState.IsSharingScreen && ExpandedVideoId != "local_screen")
                {
                    <VideoWrap Id="local_screen"
                               IsCameraOff="false"
                               IsMuted
                               IsOwn
                               OnClick=@(EventCallback.Factory.Create<string>(this, ExpandVideo)) />
                }

                @foreach (var userId in CallState.RemoteUsers)
                {
                    var id = $"video-{userId}";
                    var state = CallState.PeerStates.GetValueOrDefault(userId);

                    @if (ExpandedVideoId == id || state is null) { continue; }
                    <VideoWrap Id=@id
                               IsCameraOff=@(!state.Video)
                               IsMuted=@(!state.Audio)
                               IsOwn="false"
                               OnClick=@(EventCallback.Factory.Create<string>(this, ExpandVideo)) />
                }

                @foreach (var userId in CallState.RemoteScreenUsers)
                {
                    var id = $"screen-{userId}";

                    @if (ExpandedVideoId == id) { continue; }

                    <VideoWrap Id=@id
                               IsCameraOff="false"
                               IsMuted="true"
                               IsOwn="false"
                               OnClick=@(EventCallback.Factory.Create<string>(this, ExpandVideo)) />
                }

            </MudStack>

            @if (ExpandedVideoId != null)
            {
                <VideoWrap Id=@ExpandedVideoId
                           IsCameraOff="false"
                           IsMuted="true"
                           IsOwn="false"
                           OnClick=@(EventCallback.Factory.Create<string>(this, CollapseVideo)) />
            }
            <CallControlPanel />
        </MudStack>
    </Content>
</LoadingWrapper>