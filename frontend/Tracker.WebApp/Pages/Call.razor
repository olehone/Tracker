@page "/"

<div class="container">
    <div class="camerabox">
        <video id="received_video" autoplay></video>
        <video id="local_video" autoplay muted></video>
        <button id="hangup-button"
                @onclick=@HangUpCall
                role="button"
                disabled>
            Hang Up
        </button>
    </div>
    <div class="empty-container"></div>
</div>


