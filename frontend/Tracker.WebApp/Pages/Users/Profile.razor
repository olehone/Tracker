@page "/users/{UserId:guid}"

@using Microsoft.AspNetCore.Components.Authorization
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users
@using Tracker.WebApp.Components.Workspaces

@if (User is not null)
{
	<MudContainer MaxWidth="MaxWidth.Medium">
		<WorkWindow Elevation=0>

			<Header>
				<MudGrid>
					<MudItem xs=12
							 sm="4">
						<BigUserAvatar User=@User />
					</MudItem>

					<MudItem xs="12"
							 sm="8">
						<UserInfo User=@User />
					</MudItem>
				</MudGrid>
			</Header>

			<Body>
				<MudTabs Position="Position.Top"
						 Outlined
						 Rounded
						 Centered
						 Border
						 ApplyEffectsToContainer
						 Class="mt-8"
						 PanelClass="pa-0">
					<AuthorizeView>
						<MudTabPanel Text="All user workspaces">
							<WorkspaceList LoadWorkspaces=@LoadAllWorkspaces
										   Height="40vh" />
						</MudTabPanel>
					</AuthorizeView>

					<MudTabPanel Text="Shared workspaces">
						<WorkspaceList LoadWorkspaces=@LoadWorkspaces
									   Height="40vh" />
					</MudTabPanel>

				</MudTabs>
			</Body>
		</WorkWindow>
	</MudContainer>
}
