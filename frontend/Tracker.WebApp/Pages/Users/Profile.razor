@page "/users/{UserId:guid}"

@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Components.Users
@using Tracker.WebApp.Components.Workspaces

@if (User is not null)
{
	<MudContainer MaxWidth="MaxWidth.Medium">
		<UserInfo User=@User />
		<AuthorizeView>
			<MudTabs Position="Position.Top"
					 Outlined
					 Rounded
					 Centered
					 Border
					 ApplyEffectsToContainer
					 Class="mt-8"
					 PanelClass="pa-0">

				@if (AppState.MyId == User.Id)
				{
					<MudTabPanel Text="My workspaces">
						<WorkspaceList LoadWorkspaces=@LoadAllWorkspaces
									   Height="40vh" />
					</MudTabPanel>
				}
				else
				{
					<AuthorizeView Policy="AdminOrHigher" Context="admin">
						<MudTabPanel Text="All workspaces">
							<WorkspaceList LoadWorkspaces=@LoadAllWorkspaces
										   Height="40vh" />
						</MudTabPanel>
					</AuthorizeView>

					<MudTabPanel Text="Shared workspaces">
						<WorkspaceList LoadWorkspaces=@LoadWorkspaces
									   Height="40vh" />
					</MudTabPanel>
				}

			</MudTabs>
		</AuthorizeView>
	</MudContainer>
}
