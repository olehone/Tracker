@page "/workspaces/{WorkspaceId:guid}/settings"
@using FluentValidation
@using MudBlazor
@using Tracker.Domain.Dtos
@using Tracker.Domain.Enums
@using Tracker.Domain.Requests.Workspace
@using Tracker.WebApp.Components.Shared
@using Tracker.WebApp.Shared

<PageTitle>@PageTitle() settings</PageTitle>
<MudContainer MaxWidth=MaxWidth.Small>
	<MudPaper Elevation="5"
			  Class="my-5 pa-4">

		@if (isLoading)
		{
			<MudProgressCircular Indeterminate="true" Color="Color.Primary" />
		}
		else if (Workspace != null)
		{

			<MudForm @ref="_form" Model="@model" Validation=@validator ValidationDelay="300">
				<MudText Typo="Typo.h5" Class="mb-4">Edit Workspace</MudText>
				<MudTextField @bind-Value="model.Title" Label="Title" Required="true" />
				<MudTextField @bind-Value="model.Description" Label="Description" Lines="3" />

				<MudSelect @bind-Value="model.Visibility" Label="Visibility">
					<MudSelectItem Value="WorkspaceVisibility.Public">Public</MudSelectItem>
					<MudSelectItem Value="WorkspaceVisibility.Private">Private</MudSelectItem>
				</MudSelect>

				<MudSelect @bind-Value="model.PermissionRoles.MinCreateBoardRole" Label="Who can create boards" Variant="Variant.Outlined">
					<MudSelectItem Value=@WorkspacePermissionRole.Any>
						<MudStack Row>
							<MudIcon Icon=@Icons.Material.Filled.Public /> Anyone
						</MudStack>
					</MudSelectItem>
					<MudSelectItem Value=@WorkspacePermissionRole.Observer>
						<MudStack Row>
							<MudIcon Icon=@Icons.Material.Filled.Hail /> Observers and higher
						</MudStack>
					</MudSelectItem>
					<MudSelectItem Value=@WorkspacePermissionRole.Member>
						<MudStack Row>
							<MudIcon Icon=@Icons.Material.Filled.Group /> Members and higher
						</MudStack>
					</MudSelectItem>
					<MudSelectItem Value=@WorkspacePermissionRole.Admin>
						<MudStack Row>
							<MudIcon Icon=@Icons.Material.Filled.Groups /> Admin and higher
						</MudStack>
					</MudSelectItem>
					<MudSelectItem Value=@WorkspacePermissionRole.Owner>
						<MudStack Row>
							<MudIcon Icon=@Icons.Material.Filled.Person /> Owner only
						</MudStack>
					</MudSelectItem>
					<MudSelectItem Value=@WorkspacePermissionRole.None>
						<MudStack Row>
							<MudIcon Icon=@Icons.Material.Filled.PersonOff /> Nobody
						</MudStack>
					</MudSelectItem>
				</MudSelect>

				<MudButton Disabled="@isSubmitting" OnClick="@Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4">
					@if (isSubmitting)
					{
						<MudProgressCircular Size=Size.Medium Indeterminate="true" Color="Color.Inherit" />
						<span class="ml-2">Saving...</span>
					}
					else
					{
						<MudText>Save</MudText>
					}
				</MudButton>
			</MudForm>
		}
		else
		{
			<MudText>Workspace not found.</MudText>
		}
	</MudPaper>
</MudContainer>

